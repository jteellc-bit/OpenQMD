1x1 controller 9 (UART command protocol)

Perfect — here’s the next piece: a **UART command protocol** that lets you talk to the controller (over serial or USB-UART) to:

✅ Start or stop the control loop
✅ Switch between DE5 parameter table rows
✅ Enable/disable continuous telemetry streaming
✅ Query current DE5 values on demand

It’s intentionally lightweight, human-readable, and compatible with both `screen`/`minicom` and a Python serial script.

---

## 📁 Updated `main.c` (UART Protocol Integrated)

```c
#include "main.h"
#include "DE5_Control.h"
#include "QMD_Control.h"
#include "stm32f4xx_hal.h"
#include <stdio.h>
#include <string.h>
#include <stdlib.h>

/* Handles */
ADC_HandleTypeDef hadc1;
TIM_HandleTypeDef htim1;
TIM_HandleTypeDef htim2;
UART_HandleTypeDef huart2;

/* Control variables */
static float rotor_angle = 0.0f;
static float measured_current = 0.0f;
static DE5_Command de5_cmd;
static char uart_buf[128];
static char uart_rx[64];
static volatile uint8_t control_enabled = 0;
static volatile uint8_t telemetry_enabled = 0;

/* Prototypes */
void SystemClock_Config(void);
static void MX_GPIO_Init(void);
static void MX_ADC1_Init(void);
static void MX_TIM1_Init(void);
static void MX_TIM2_Init(void);
static void MX_USART2_UART_Init(void);

void ProcessUARTCommand(char *cmd);
void SetPWM_FromVoltageCommand(float v_norm);
void Control_Loop(void);

/* --- UART RX interrupt handler --- */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART2)
    {
        ProcessUARTCommand(uart_rx);
        HAL_UART_Receive_IT(&huart2, (uint8_t *)uart_rx, 1);
    }
}

/* --- Simple helper: map normalized voltage to PWM --- */
void SetPWM_FromVoltageCommand(float v_norm)
{
    if (v_norm > 1.0f) v_norm = 1.0f;
    if (v_norm < -1.0f) v_norm = -1.0f;
    uint32_t duty = (uint32_t)((v_norm * 0.5f + 0.5f) * (__HAL_TIM_GET_AUTORELOAD(&htim1)));
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, duty);
}

/* --- Control loop (1 kHz interrupt) --- */
void Control_Loop(void)
{
    if (!control_enabled)
        return;

    HAL_ADC_Start(&hadc1);
    HAL_ADC_PollForConversion(&hadc1, 10);
    measured_current = (float)HAL_ADC_GetValue(&hadc1) * (3.3f / 4096.0f);

    DE5_ComputeControl(rotor_angle, measured_current, &de5_cmd);
    SetPWM_FromVoltageCommand(de5_cmd.V_command);

    if (telemetry_enabled)
    {
        int len = snprintf(uart_buf, sizeof(uart_buf),
            "%.3f,%.3f,%.3f,%.3f\r\n",
            rotor_angle, measured_current, de5_cmd.V_command, de5_cmd.I_target);
        HAL_UART_Transmit(&huart2, (uint8_t *)uart_buf, len, 10);
    }

    rotor_angle += 0.05f;
    if (rotor_angle > 6.283f) rotor_angle -= 6.283f;
}

/* --- UART Command Parser --- */
void ProcessUARTCommand(char *cmd)
{
    switch (cmd[0])
    {
    case 'S': // Start control
        control_enabled = 1;
        HAL_UART_Transmit(&huart2, (uint8_t *)"CONTROL START\r\n", 15, 10);
        break;

    case 'P': // Pause control
        control_enabled = 0;
        HAL_UART_Transmit(&huart2, (uint8_t *)"CONTROL PAUSE\r\n", 15, 10);
        break;

    case 'T': // Toggle telemetry
        telemetry_enabled = !telemetry_enabled;
        HAL_UART_Transmit(&huart2,
                          (uint8_t *)(telemetry_enabled ? "TELEM ON\r\n" : "TELEM OFF\r\n"),
                          telemetry_enabled ? 10 : 11, 10);
        break;

    case 'R': // Select DE5 table row (R<n>)
    {
        int row = atoi(&cmd[1]);
        DE5_SelectActiveRow(row);
        snprintf(uart_buf, sizeof(uart_buf), "ROW %d SELECTED\r\n", row);
        HAL_UART_Transmit(&huart2, (uint8_t *)uart_buf, strlen(uart_buf), 10);
    }
    break;

    case 'Q': // Query current DE5 params
        snprintf(uart_buf, sizeof(uart_buf),
                 "I_tgt=%.3f V_cmd=%.3f Row=%d\r\n",
                 de5_cmd.I_target, de5_cmd.V_command, DE5_GetActiveRow());
        HAL_UART_Transmit(&huart2, (uint8_t *)uart_buf, strlen(uart_buf), 10);
        break;

    default:
        HAL_UART_Transmit(&huart2, (uint8_t *)"?\r\n", 3, 10);
        break;
    }
}

/* --- Timer interrupt --- */
void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance == TIM2)
        Control_Loop();
}

/* --- Main --- */
int main(void)
{
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_ADC1_Init();
    MX_TIM1_Init();
    MX_TIM2_Init();
    MX_USART2_UART_Init();

    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
    HAL_TIM_Base_Start_IT(&htim2);

    const char *csv =
        "515.17,0.29,2,1012,20.0,8271.06,0.999869,81932.44,0.0005\n"
        "480.00,0.32,2,1050,21.0,8100.00,0.999850,83000.00,0.0006\n";
    DE5_LoadParamsFromFlash(csv);
    DE5_SelectActiveRow(0);

    HAL_UART_Receive_IT(&huart2, (uint8_t *)uart_rx, 1);

    while (1)
    {
        // Idle — waiting for interrupts
    }
}
```

