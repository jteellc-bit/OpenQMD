def make_local_grid(center, diam_span=200.0, diam_steps=9, gap_span=0.6, gap_steps=6, turn_pct=0.25, poles_list=None):
    if poles_list is None:
        poles_list = [2,3,4,5]
    diam_vals = np.linspace(center['coil_diam_mm'] - diam_span/2.0, center['coil_diam_mm'] + diam_span/2.0, diam_steps)
    gap_vals = np.linspace(max(0.2, center['air_gap_mm'] - gap_span/2.0), center['air_gap_mm'] + gap_span/2.0, gap_steps)
    turns_low = max(10, int(center['turns'] * (1.0 - turn_pct)))
    turns_high = max(turns_low+1, int(center['turns'] * (1.0 + turn_pct)))
    turn_vals = np.unique(np.round(np.linspace(turns_low, turns_high, max(5, int(turn_pct*20))))) # Corrected: Removed extra ')'
    turn_vals = turn_vals.astype(int)
    grid = []
    for D in diam_vals:
        for g in gap_vals:
            for p in poles_list:
                for N in turn_vals:
                    grid.append({'coil_diam_mm': float(D), 'air_gap_mm': float(g), 'poles': int(p), 'turns': int(N)})
    return grid

# build grid (tunable)
