# --- Physics Evaluator Function ---
def eval_motor_proxy(params, I_req=None, cooling_type='Baseline', copper_loss_reduction_factor=1.0):
    D_mm = float(params['coil_diam_mm'])
    g_mm = float(params['air_gap_mm'])
    p = int(params['poles'])
    N = int(params['turns'])
    I = float(I_req) if I_req is not None else 10.0

    D_m = D_mm / 1000.0
    g_m = g_mm / 1000.0

    area_m2 = np.pi * (D_m/2.0)**2
    M_H = 1e-6 * area_m2 * (N**2) / (g_m + 1e-3)
    pred_torque_Nm = M_H * 50.0

    R_winding = (0.00005 * copper_loss_reduction_factor) * N * (D_mm / 100)
    P_copper_W = (I**2) * R_winding

    nominal_speed_rad_s = 100
    P_core_W = 0.000005 * p * nominal_speed_rad_s * (N / g_mm)
    P_windage_W = 0.005 * nominal_speed_rad_s
    P_loss_W = P_copper_W + P_core_W + P_windage_W

    P_out_W = pred_torque_Nm * nominal_speed_rad_s
    P_out_W = max(P_out_W, 1e-6)

    pred_efficiency = P_out_W / (P_out_W + P_loss_W)
    pred_efficiency = np.clip(pred_efficiency, 0, 1)

    thermal_resistance_coefficient = thermal_resistance_map.get(cooling_type, 0.001)
    deltaT_C = P_loss_W * thermal_resistance_coefficient

    coil_temp_est_C = AMBIENT_C + deltaT_C
    thermal_margin_C = TMAX_ALLOWED_C - coil_temp_est_C

    k_t = pred_torque_Nm / I if I != 0 else 0.0
    I_req_A = I

    thermal_ok = thermal_margin_C > THERMAL_MARGIN_REQ_C
    I_req_reasonable = I_req_A < I_REQ_THRESHOLD_A
    eff_high = pred_efficiency > EFF_HIGH_THRESH
    prototype_ready = thermal_ok and I_req_reasonable and (pred_efficiency > 0.70)

    return {
        'coil_diam_mm': D_mm, 'air_gap_mm': g_mm, 'poles': p, 'turns': N,
        'M_H': float(M_H),
        'pred_torque_Nm': float(pred_torque_Nm),
        'pred_efficiency': float(pred_efficiency),
        'k_t': float(k_t),
        'I_req_A': float(I_req_A),
        'P_copper_W': float(P_copper_W),
        'P_core_W': float(P_core_W),
        'P_windage_W': float(P_windage_W),
        'P_loss_W': float(P_loss_W),
        'P_out_W': float(P_out_W),
        'deltaT_C': float(deltaT_C),
        'area_m2': float(area_m2),
        'coil_temp_est_C': float(coil_temp_est_C),
        'thermal_margin_C': float(thermal_margin_C),
        'thermal_ok': bool(thermal_ok),
        'I_req_reasonable': bool(I_req_reasonable),
        'eff_high': bool(eff_high),
        'prototype_ready': bool(prototype_ready)
    }

