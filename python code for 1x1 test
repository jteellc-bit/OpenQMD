# --- Main Pipeline Function ---
def run_local_pipeline(grid, batteries, run_continuous=True, run_peak=False, n_jobs=4, demo_mode=False, cooling_type='Baseline', copper_loss_reduction_factor=1.0):
    frames = []
    print(f"Starting evaluation. Points: {len(grid)}, batteries: {list(batteries.keys())}, Cooling Type: {cooling_type}, Copper Loss Reduction Factor: {copper_loss_reduction_factor}")
    if run_continuous:
        print("- evaluating continuous currents")
        df_cont = evaluate_grid(grid, list(batteries.keys()), I_mode='cont', n_jobs=n_jobs, cooling_type=cooling_type, copper_loss_reduction_factor=copper_loss_reduction_factor)
        frames.append(df_cont)
    if run_peak:
        print("- evaluating peak currents")
        df_peak = evaluate_grid(grid, list(batteries.keys()), I_mode='peak', n_jobs=n_jobs, cooling_type=cooling_type, copper_loss_reduction_factor=copper_loss_reduction_factor)
        frames.append(df_peak)
    df_all = pd.concat(frames, ignore_index=True)

    # NEW POST-PROCESSING STEP
    df_all['pred_efficiency_adjusted'] = df_all['pred_efficiency'] - (3 * sigma_eff)
    df_all['pred_efficiency_adjusted'] = np.clip(df_all['pred_efficiency_adjusted'], 0.0, 1.0)

    eff_adjusted_safe = np.where(df_all['pred_efficiency_adjusted'] < 1e-6, 1e-6, df_all['pred_efficiency_adjusted'])
    df_all['P_loss_W'] = df_all['P_out_W'] * (1 / eff_adjusted_safe - 1)
    df_all['P_loss_W'] = np.maximum(df_all['P_loss_W'], 0)

    df_all['deltaT_C'] = df_all['P_loss_W'] * thermal_resistance_map.get(cooling_type, 0.001)
    df_all['coil_temp_est_C'] = AMBIENT_C + df_all['deltaT_C']
    df_all['thermal_margin_C'] = TMAX_ALLOWED_C - df_all['coil_temp_est_C']

    df_all['thermal_ok'] = df_all['thermal_margin_C'] > THERMAL_MARGIN_REQ_C
    df_all['I_req_reasonable_flag'] = df_all['I_req_A'] < I_REQ_THRESHOLD_A
    df_all['eff_high'] = df_all['pred_efficiency_adjusted'] > EFF_HIGH_THRESH
    df_all['prototype_ready'] = df_all['thermal_ok'] & df_all['I_req_reasonable_flag'] & (df_all['eff_high'])

    pareto_df = compute_pareto(df_all)
    top30_path = export_topN_fem(df_all, topN=30, path=os.path.join(out_dir,f'DE5_top30_FEM_inputs_{cooling_type}.csv'))
    top10_path = export_topN_fem(df_all, topN=10, path=os.path.join(out_dir,f'DE5_top10_FEM_inputs_{cooling_type}.csv'))

    num_points_in_df = len(df_all)
    n_for_sample = min(num_points_in_df, 3000)
    sample_df = df_all.sample(n=n_for_sample, random_state=42)
    surrogates = train_surrogate_models(sample_df)

    pareto_plot_path = os.path.join(out_dir, f'DE5_par_scatter_{cooling_type}.png')
    plot_pareto(df_all, outpath=pareto_plot_path)

    surface_plot_path = os.path.join(out_dir, f"DE5_local_surface_{cooling_type}_{datetime.now(timezone.utc).strftime("%Y%m%dT%H%M%SZ")}.png")
    # The original surface plot generation was commented out, so this is a placeholder path.
    # If actual surface plot generation is desired, implement it here.
    
    df_all.to_csv(os.path.join(out_dir,f'DE5_pareto_with_thermal_metrics_{cooling_type}.csv'), index=False)
    pareto_df.to_csv(os.path.join(out_dir,f'DE5_pareto_front_{cooling_type}.csv'), index=False)

    info = {
        'df_all_path': os.path.join(out_dir,f'DE5_pareto_with_thermal_metrics_{cooling_type}.csv'),
        'pareto_path': os.path.join(out_dir,f'DE5_pareto_front_{cooling_type}.csv'),
        'top30_fem': top30_path,
        'top10_fem': top10_path,
        'surrogate_r2': {k:v['r2_test'] for k,v in surrogates.items()},
        'n_points': len(df_all),
        'pareto_plot': pareto_plot_path,
        'surface_plot': surface_plot_path
    }
    return info, df_all, pareto_df, surrogates

