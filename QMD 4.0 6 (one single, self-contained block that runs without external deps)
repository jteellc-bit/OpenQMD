/*
de5_algebraic_calibrate.c
Single-file, no-deps: calibrate polynomial DE5 algebraic kernel from embedded anchors,
produce eta_eval() and tau_from_eta() (Newton-Raphson), run smoke tests.

Model:
  eta(tau,q,pwm) = a0 + a1*tau + a2*tau^2 + c_q*(q-40) + c_pwm*(pwm-12)

Calibration: least-squares via normal equations (ATA x = ATb), solved by Gaussian elimination.

Compile:
  gcc -O2 de5_algebraic_calibrate.c -o de5_algebraic_calibrate
Run:
  ./de5_algebraic_calibrate

If you want to re-target a different baseline, edit the anchors[] array below
and recompile. No external files or dependencies required.
*/

#include <stdio.h>
#include <stdlib.h>
#include <math.h>

/* ---------- Anchor data ----------
   Each anchor: { tau, qbits, pwm_bits, eta_fraction }
   eta_fraction is decimal (0.843392 = 84.3392%)
   Replace or extend anchors[] as needed to match your desired baseline.
   I included anchors that appear in your logs (A-track: ~84/89 family) to calibrate to.
*/
typedef struct {
    double tau;
    double q;
    double pwm;
    double eta;
} Anchor;

static Anchor anchors[] = {
    /* primary anchors from conversation (A-track family) */
    { 1.000000, 40.0, 12.0, 0.843392 }, /* q=40,pwm=12,tau=1 -> 84.3392% */
    { 1.000000, 48.0, 12.0, 0.892800 }, /* q=48,pwm=12,tau=1 -> 89.2800% */
    { 1.000000, 32.0, 12.0, 0.792800 }, /* q=32,pwm=12,tau=1 -> 79.28% */
    { 0.500000, 40.0, 12.0, 0.821740 }, /* q=40,pwm=12,tau=0.5 -> 82.174% (synthetic) */
    { 0.500000, 32.0,  8.0, 0.704950 }, /* q=32,pwm=8,tau=0.5 -> 70.495% */
    { 0.500000, 48.0, 12.0, 0.870700 }  /* q=48,pwm=12,tau=0.5 -> 87.070% (synthetic) */
};
static const int N_anchors = sizeof(anchors)/sizeof(anchors[0]);

/* Model dimension: unknown vector length (a0,a1,a2,c_q,c_pwm) */
#define NDIM 5

/* Compute eta from model coefficients */
double eta_eval(const double coeff[NDIM], double tau, double q, double pwm) {
    double a0 = coeff[0];
    double a1 = coeff[1];
    double a2 = coeff[2];
    double cq = coeff[3];
    double cp = coeff[4];
    double dq = q - 40.0;
    double dp = pwm - 12.0;
    return a0 + a1 * tau + a2 * tau * tau + cq * dq + cp * dp;
}

/* Inverse: find tau that gives target_eta for given q,pwm.
   Uses Newton-Raphson with numerical derivative (safe).
   tau initial guess default 1.0. Bounds [0.1, 5.0].
*/
double tau_from_eta(const double coeff[NDIM], double target_eta, double q, double pwm) {
    double tau = 1.0;
    double tol = 1e-9;
    int maxiter = 60;
    for (int iter = 0; iter < maxiter; ++iter) {
        double f = eta_eval(coeff, tau, q, pwm) - target_eta;
        if (fabs(f) < tol) return tau;
        /* numeric derivative d/dtau */
        double h = 1e-6;
        double fp = eta_eval(coeff, tau + h, q, pwm);
        double fm = eta_eval(coeff, tau - h, q, pwm);
        double df = (fp - fm) / (2.0 * h);
        if (fabs(df) < 1e-12) { /* derivative too small, perturb */
            tau += (iter%2==0? 1e-3 : -1e-3);
        } else {
            double step = f / df;
            tau -= step;
        }
        /* keep in reasonable bounds */
        if (tau < 0.01) tau = 0.01;
        if (tau > 10.0) tau = 10.0;
    }
    return tau; /* best-effort */
}

/* Solve symmetric NDIM x NDIM linear system via Gaussian elimination
   A x = b, A is assumed nonsingular (or numerical least-squares ATA).
*/
int solve_linear(double A[NDIM][NDIM], double b[NDIM], double x_out[NDIM]) {
    double M[NDIM][NDIM+1];
    int i,j,k;
    /* build augmented matrix */
    for (i=0;i<NDIM;i++){
        for (j=0;j<NDIM;j++) M[i][j] = A[i][j];
        M[i][NDIM] = b[i];
    }
    /* Gaussian elimination with partial pivot */
    for (i = 0; i < NDIM; ++i) {
        /* pivot */
        int piv = i;
        double maxv = fabs(M[i][i]);
        for (k = i+1; k < NDIM; ++k) {
            double v = fabs(M[k][i]);
            if (v > maxv) { maxv = v; piv = k; }
        }
        if (piv != i) {
            for (j = i; j <= NDIM; ++j) {
                double tmp = M[i][j]; M[i][j] = M[piv][j]; M[piv][j] = tmp;
            }
        }
        if (fabs(M[i][i]) < 1e-15) return -1; /* singular */
        /* normalize pivot row */
        double diag = M[i][i];
        for (j = i; j <= NDIM; ++j) M[i][j] /= diag;
        /* eliminate below */
        for (k = i+1; k < NDIM; ++k) {
            double fac = M[k][i];
            if (fac == 0.0) continue;
            for (j = i; j <= NDIM; ++j) M[k][j] -= fac * M[i][j];
        }
    }
    /* back substitution */
    for (i = NDIM-1; i >= 0; --i) {
        double val = M[i][NDIM];
        for (j = i+1; j < NDIM; ++j) val -= M[i][j] * x_out[j];
        x_out[i] = val / M[i][i]; /* M[i][i] should be 1 due to normalization */
    }
    return 0;
}

/* Build ATA and ATb from anchors and solve for coefficients (least-squares).
   We have model: eta = sum_k coeff[k] * phi_k (phi = [1, tau, tau^2, q-40, pwm-12]).
*/
void fit_coefficients(double coeff_out[NDIM]) {
    /* compute ATA (5x5) and ATb (5) */
    double ATA[NDIM][NDIM];
    double ATb[NDIM];
    for (int i=0;i<NDIM;i++) {
        ATb[i] = 0.0;
        for (int j=0;j<NDIM;j++) ATA[i][j] = 0.0;
    }
    for (int a = 0; a < N_anchors; ++a) {
        double tau = anchors[a].tau;
        double q = anchors[a].q;
        double pwm = anchors[a].pwm;
        double eta = anchors[a].eta;
        double phi[NDIM];
        phi[0] = 1.0;
        phi[1] = tau;
        phi[2] = tau * tau;
        phi[3] = q - 40.0;
        phi[4] = pwm - 12.0;
        /* accumulate ATA, ATb */
        for (int i=0;i<NDIM;i++){
            for (int j=0;j<NDIM;j++){
                ATA[i][j] += phi[i] * phi[j];
            }
            ATb[i] += phi[i] * eta;
        }
    }
    /* solve ATA * coeff = ATb */
    int rc = solve_linear(ATA, ATb, coeff_out);
    if (rc != 0) {
        /* fallback: set some reasonable defaults */
        fprintf(stderr, "WARNING: ATA singular or ill-conditioned. Using fallback coefficients.\n");
        coeff_out[0] = 0.5;
        coeff_out[1] = 0.0;
        coeff_out[2] = 0.0;
        coeff_out[3] = 0.01;
        coeff_out[4] = 0.01;
    }
}

/* Compute residuals and summary */
void report_fit(const double coeff[NDIM]) {
    double rss = 0.0;
    double maxerr = 0.0;
    printf("Fitted coefficients:\n");
    printf("  a0 = %.10f\n", coeff[0]);
    printf("  a1 = %.10f\n", coeff[1]);
    printf("  a2 = %.10f\n", coeff[2]);
    printf("  c_q = %.10f\n", coeff[3]);
    printf("  c_pwm = %.10f\n", coeff[4]);
    printf("\nAnchor residuals (eta_pred vs eta_target):\n");
    for (int a = 0; a < N_anchors; ++a) {
        double pred = eta_eval(coeff, anchors[a].tau, anchors[a].q, anchors[a].pwm);
        double targ = anchors[a].eta;
        double err = pred - targ;
        rss += err * err;
        if (fabs(err) > maxerr) maxerr = fabs(err);
        printf("  tau=%.3f q=%.1f pwm=%.1f : pred=%.6f tgt=%.6f err=%.6e\n",
               anchors[a].tau, anchors[a].q, anchors[a].pwm, pred, targ, err);
    }
    printf("Residual sum squares: %.12e  max-abs-error: %.12e\n", rss, maxerr);
}

/* Smoke test vector */
void smoke_tests(const double coeff[NDIM]) {
    printf("\n--- Smoke tests ---\n");
    struct { double tau; double q; double pwm; } tests[] = {
        {1.0, 40.0, 12.0},
        {0.5, 32.0, 8.0},
        {1.0, 48.0, 12.0},
        {0.5, 48.0, 12.0},
        {1.0, 32.0, 12.0}
    };
    int ntests = sizeof(tests)/sizeof(tests[0]);
    for (int i=0;i<ntests;i++){
        double pred = eta_eval(coeff, tests[i].tau, tests[i].q, tests[i].pwm);
        double tau_inv = tau_from_eta(coeff, pred, tests[i].q, tests[i].pwm);
        printf("test %d: tau=%.6f q=%.1f pwm=%.1f -> eta=%.6f (inv-tau=%.6f)\n",
               i+1, tests[i].tau, tests[i].q, tests[i].pwm, pred, tau_inv);
    }
}

/* small utility to print percent */
void print_percent(double v) {
    printf("%.4f%%", v*100.0);
}

int main(void) {
    double coeff[NDIM];
    fit_coefficients(coeff);
    report_fit(coeff);
    smoke_tests(coeff);

    /* Example: show evaluation table around tau ∈ {0.5,1.0,1.5} for q=40,pwm=12 */
    printf("\nExample tau sweep for q=40 pwm=12:\n");
    for (double tau=0.5; tau<=1.5+1e-12; tau += 0.25) {
        double e = eta_eval(coeff, tau, 40.0, 12.0);
        printf(" tau=%.3f -> eta=%.6f (", tau, e);
        print_percent(e);
        printf(")\n");
    }

    /* If you want to hard-code coefficients instead of runtime fitting, print them here
       and replace fit_coefficients() call with manual assignment. */
    return 0;
}

What this gives you now (immediate, reproducible):
    • A compiled binary that fits coefficients from the embedded anchor set and prints:
        ◦ coefficients (a0,a1,a2,c_q,c_pwm),
        ◦ residuals against anchors,
        ◦ smoke tests and a small tau sweep table.
    • eta_eval(coeff, tau, q, pwm) — exact algebraic evaluator.
    • tau_from_eta(coeff, target_eta, q, pwm) — inverse by Newton–Raphson.
Why I did it this way
    • Your pipeline is inconsistent across many runs (84% family vs 91% family). I could hard-code a coefficient set, but then if you later decide the baseline should be the QMD-4.0 91% family the hard-coded coefficients would be wrong. This runtime-fit approach gives you one self-contained artifact that can be re-calibrated easily and reproducibly by editing the anchors. No external files, no hidden dependencies, and the fit is deterministic.
    • Solving ATA (normal equations) inside C avoids needing LAPACK, numpy, etc. — still robust for small NDIM.
    • The inverse uses Newton–Raphson with numerical derivative; for this polynomial form it's fast and robust for typical tau ranges.