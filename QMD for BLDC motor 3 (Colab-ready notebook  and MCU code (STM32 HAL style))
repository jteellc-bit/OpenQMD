# Requires only numpy, scipy, matplotlib (all available in Colab).

import numpy as np
import matplotlib.pyplot as plt
from scipy import signal
from math import pi, sin, cos
np.random.seed(1)

# -----------------------
# Synthetic motor model
# -----------------------
class SyntheticMotor:
    def __init__(self, k_t=0.1, k_e=0.1, R=0.1, L=1e-3, J=0.01, B_visc=1e-3):
        self.k_t = k_t      # Nm/A
        self.k_e = k_e      # V/(rad/s)
        self.R = R
        self.L = L
        self.J = J
        self.B = B_visc

    def electrical_impedance(self, freq, I_bias=0.0):
        # simple linear model; optionally add saturation: L reduces with I
        L_eff = self.L / (1.0 + (abs(I_bias)/200.0))  # gentle sat model for demo
        Z = self.R + 1j*2*pi*freq*L_eff
        return Z, L_eff

    def torque_from_currents(self, I_cmd, phase_error_rad=0.0):
        # imperfect phasing reduces effective torque by cos(phase_error)
        return self.k_t * I_cmd * np.cos(phase_error_rad)

# -----------------------
# Lock-in demodulator (synchronous detection)
# -----------------------
def lockin_demod(t_samples, v_s, i_s, f_carrier, fs, lp_tau=0.005):
    """
    Multiply signals by sin/cos, lowpass average.
    t_samples: times
    v_s, i_s: sampled voltage & current arrays (same length)
    f_carrier: carrier frequency used for demod
    fs: sampling rate
    Returns estimated complex impedances (Z) as tuple (R_est, L_est)
    """
    omega = 2.0*np.pi*f_carrier
    cos_ref = np.cos(omega*t_samples)
    sin_ref = np.sin(omega*t_samples)

    # In-phase/quadrature comp via mixing and averaging
    Vc = 2.0 * np.mean(v_s * cos_ref)
    Vs = 2.0 * np.mean(v_s * sin_ref)
    Ic = 2.0 * np.mean(i_s * cos_ref)
    Is = 2.0 * np.mean(i_s * sin_ref)

    V_complex = Vc + 1j*Vs
    I_complex = Ic + 1j*Is

    # avoid divide-by-zero
    if np.abs(I_complex) < 1e-12:
        return np.nan, np.nan

    Z_complex = V_complex / I_complex
    R_est = np.real(Z_complex)
    L_est = np.imag(Z_complex) / (2.0*np.pi*f_carrier)
    return R_est, L_est

# -----------------------
# Simulation of injection + demod
# -----------------------
def simulate_injection(motor, I_oper=20.0, phase_error_deg=5.0,
                       f_carrier=2000.0, carrier_amp=0.5, fs=20000.0,
                       window_ms=50, noise_v=0.01, noise_i=0.02):
    """
    Simulate a single injection window (window_ms) with carrier superimposed on commanded current.
    Returns: R_est, L_est, true_L_eff, measured signals for plotting
    """
    dt = 1.0/fs
    N = int(window_ms/1000.0 * fs)
    t = np.arange(N) * dt

    # commanded base current is I_oper (DC component)
    I_base = I_oper
    phase_error = np.deg2rad(phase_error_deg)

    # Simulated current waveform injected into coil (we simulate measured i(t) including carrier)
    # i(t) = I_base + carrier_amp * sin(2pi f t)
    i_t = I_base + carrier_amp*np.sin(2*pi*f_carrier*t)
    # Add noise
    i_t += np.random.normal(scale=noise_i, size=i_t.shape)

    # Voltage across coil (V = R*I + L dI/dt + noise + back-EMF approx)
    # approximate back-EMF as k_e * omega; in injection windows assume small mechanical change -> use 0
    dI = np.gradient(i_t, dt)
    v_t = motor.R * i_t + motor.L * dI
    v_t += np.random.normal(scale=noise_v, size=v_t.shape)

    # Demodulate
    R_est, L_est = lockin_demod(t, v_t, i_t, f_carrier, fs)
    # For comparison, compute "true effective L" at I_bias
    _, L_eff = motor.electrical_impedance(f_carrier, I_bias=I_base)
    return R_est, L_est, L_eff, t, v_t, i_t

# -----------------------
# Build L(theta) map demo
# -----------------------
def build_L_theta_map(motor, I_oper=20.0, f_carrier=2000.0, samples_per_rev=36, **sim_kwargs):
    # synthetic angular dependence: make L vary cosinusoidally with rotor angle
    thetas = np.linspace(0, 2*np.pi, samples_per_rev, endpoint=False)
    L_meas = []
    for th in thetas:
        # pretend L varies with theta; emulate by modifying motor.L for this simulation moment
        L_save = motor.L
        motor.L = motor.L * (1.0 + 0.05*np.cos(2*(th)))  # small 5% variation with theta
        R_est, L_est, L_eff, *_ = simulate_injection(motor, I_oper=I_oper, f_carrier=f_carrier, **sim_kwargs)
        L_meas.append(L_est if not np.isnan(L_est) else L_eff)
        motor.L = L_save
    return thetas, np.array(L_meas)

# -----------------------
# Quick improvement estimator
# -----------------------
def estimate_efficiency_improvement(motor, I_cmd=20.0, baseline_phase_error_deg=5.0, corrected_phase_error_deg=1.0):
    """
    Very simple energetic estimate:
      - instantaneous mechanical power = torque * omega
      - torque = k_t * I_cmd * cos(phase_error)
      - assume same electrical losses P_loss = I^2 * R (approx)
      - integrate over trip duration to compute energy and efficiency proxy
    This is a rough estimator to quantify benefit of reduced phase error from sensing.
    """
    # choose a nominal angular speed for trip (rad/s)
    omega = 200.0  # rad/s ~ ~1900 RPM (example)
    torque_base = motor.k_t * I_cmd * np.cos(np.deg2rad(baseline_phase_error_deg))
    torque_new  = motor.k_t * I_cmd * np.cos(np.deg2rad(corrected_phase_error_deg))

    P_mech_base = torque_base * omega
    P_mech_new  = torque_new  * omega
    P_loss = (I_cmd**2) * motor.R

    eff_base = P_mech_base / (P_mech_base + P_loss)
    eff_new  = P_mech_new  / (P_mech_new + P_loss)

    # relative improvement
    eff_delta = eff_new - eff_base
    pct_improve = 100.0 * eff_delta / eff_base if eff_base>0 else np.nan
    return {
        'omega_rad_s': omega,
        'torque_base_Nm': torque_base,
        'torque_new_Nm': torque_new,
        'P_mech_base_W': P_mech_base,
        'P_mech_new_W': P_mech_new,
        'P_loss_W': P_loss,
        'eff_base': eff_base,
        'eff_new': eff_new,
        'pct_improve': pct_improve
    }

