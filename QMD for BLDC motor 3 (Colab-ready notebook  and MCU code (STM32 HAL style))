2 — MCU-ready STM32 HAL C skeleton (non-blocking, ISR-driven lock-in demod)
Below is a compact, copy-paste friendly qmd_lockin.c + header qmd_lockin.h plus a short usage note. This assumes:
    • You run PWM to inject the carrier (small duty modulation),
    • ADC sampling is synchronized by a timer (TIM) TRGO to call ADC conversions,
    • The code runs on Cortex-M (STM32F4/F7/M4) with HAL drivers available.

qmd_lockin.h
#ifndef QMD_LOCKIN_H
#define QMD_LOCKIN_H

#include <stdint.h>
#include <stdbool.h>

typedef struct {
    float acc_vc;
    float acc_vs;
    float acc_ic;
    float acc_is;
    uint32_t sample_count;
    uint32_t samples_per_cycle;
    float fs;
    float f_carrier;
    uint32_t idx;
    float cos_table[256];
    float sin_table[256];
    float R_est;
    float L_est;
    bool ready;
    float inject_amp;   // A - small relative to I_nom
    float I_nom;        // nominal phase current for safety
    float I_bus_limit;  // clamp limit
} qmd_lockin_t;

void qmd_lockin_init(qmd_lockin_t *s, float f_carrier, float fs, uint32_t samples_per_cycle);
void qmd_lockin_reset_accumulators(qmd_lockin_t *s);
void qmd_lockin_feed_sample(qmd_lockin_t *s, float v_sample, float i_sample);
void qmd_lockin_compute(qmd_lockin_t *s);
void qmd_lockin_set_inject(qmd_lockin_t *s, float amp);
bool qmd_lockin_is_ready(qmd_lockin_t *s);

#endif // QMD_LOCKIN_H

qmd_lockin.c
#include "qmd_lockin.h"
#include <math.h>
#include <string.h>

#ifndef M_PI
#define M_PI 3.14159265358979323846f
#endif

void qmd_lockin_init(qmd_lockin_t *s, float f_carrier, float fs, uint32_t samples_per_cycle) {
    memset(s, 0, sizeof(qmd_lockin_t));
    s->f_carrier = f_carrier;
    s->fs = fs;
    s->samples_per_cycle = samples_per_cycle;
    s->sample_count = 0;
    s->idx = 0;
    for (uint32_t n = 0; n < samples_per_cycle && n < 256; ++n) {
        float t = (float)n / fs;
        s->cos_table[n] = cosf(2.0f * M_PI * f_carrier * t);
        s->sin_table[n] = sinf(2.0f * M_PI * f_carrier * t);
    }
    s->ready = false;
    s->R_est = 0.0f;
    s->L_est = 0.0f;
    s->inject_amp = 0.0f;
    s->I_nom = 100.0f;
    s->I_bus_limit = 250.0f;
}

void qmd_lockin_reset_accumulators(qmd_lockin_t *s) {
    s->acc_vc = s->acc_vs = s->acc_ic = s->acc_is = 0.0f;
    s->sample_count = 0;
    s->idx = 0;
    s->ready = false;
}

void qmd_lockin_feed_sample(qmd_lockin_t *s, float v_sample, float i_sample) {
    // Safety clamp on sample current (prevent runaway values)
    if (i_sample > s->I_bus_limit) i_sample = s->I_bus_limit;
    if (i_sample < -s->I_bus_limit) i_sample = -s->I_bus_limit;

    uint32_t idx = s->idx;
    float c = s->cos_table[idx];
    float si = s->sin_table[idx];

    // Multiply & accumulate
    s->acc_vc += v_sample * c;
    s->acc_vs += v_sample * si;
    s->acc_ic += i_sample * c;
    s->acc_is += i_sample * si;

    s->sample_count++;
    idx++;
    if (idx >= s->samples_per_cycle) {
        // cycle complete -> compute
        s->idx = 0;
        qmd_lockin_compute(s);
    } else {
        s->idx = idx;
    }
}

void qmd_lockin_compute(qmd_lockin_t *s) {
    // Apply normalization (2.0 / N) similar to lock-in demod
    float Nf = (s->sample_count > 0) ? (2.0f / (float)s->sample_count) : 0.0f;
    float Vc = s->acc_vc * Nf;
    float Vs = s->acc_vs * Nf;
    float Ic = s->acc_ic * Nf;
    float Is = s->acc_is * Nf;

    float I_complex_mag = sqrtf(Ic*Ic + Is*Is);
    if (I_complex_mag < 1e-9f) {
        s->R_est = NAN;
        s->L_est = NAN;
    } else {
        float Vr = Vc;
        float Vi = Vs;
        // Complex division Z = V / I
        // (a+jb)/(c+jd) = ( (ac+bd) + j(bc-ad) )/(c^2+d^2)
        float denom = (Ic*Ic + Is*Is);
        float Zr = (Vr*Ic + Vi*Is) / denom;
        float Zi = (Vi*Ic - Vr*Is) / denom;
        s->R_est = Zr;
        s->L_est = Zi / (2.0f * M_PI * s->f_carrier);
    }

    // reset accum
    s->acc_vc = s->acc_vs = s->acc_ic = s->acc_is = 0.0f;
    s->sample_count = 0;
    s->ready = true;
}

// simple setters/getters
void qmd_lockin_set_inject(qmd_lockin_t *s, float amp) { s->inject_amp = amp; }
bool qmd_lockin_is_ready(qmd_lockin_t *s) { return s->ready; }

Short usage notes (how to wire into firmware)
    • Use TIM to generate PWM and a small carrier modulation:
        ◦ For injection, modulate PWM duty by a tiny offset (inject_amp / I_nom scaled).
        ◦ Or, use a DAC channel to generate the carrier waveform if available and sum with PWM via filter.
    • Use TIM (another timer) to trigger ADC sampling at fs (e.g., 10–50 kHz) using hardware TRGO so samples align with carrier table.
    • In HAL_TIM_PeriodElapsedCallback or ADC conversion complete callback, read and convert ADC values to volts/amps, then call qmd_lockin_feed_sample(&lockin, v, i).
    • After qmd_lockin_is_ready, read lockin.R_est and lockin.L_est, publish to control thread (e.g., via RTOS queue), and use to update phase estimation or saturation logic.
    • Clamps & safety: ensure the injection amplitude and controller never request I_total > I_bus_limit. Always include a watchdog to disable injection when ADC saturates or BMS signals a fault.

3 — How to estimate improvement (method + conservative numbers)
Short answer (estimate ranges):
    • With a modest reduction in phase error from 5° → 1°, and typical motor parameters (k_t~0.1–0.3 Nm/A), you can expect mechanical power increase on the order of 3–12% (depends on cos(θ) change), and overall efficiency improvement in the range of 1–6% absolute (relative improvement larger when base efficiency is low).
    • For a vehicle trip where baseline motor runs in low-efficiency region (say 80%) and QMD shifts operating point to 88–92%, range gains of 5–25% are plausible depending on drive cycle and baseline operating point.
How the notebook computes an estimate (conservative, transparent):
    • Torque scales with cos(phase_error). Drop of 5°→1° increases cos by cos(1°)/cos(5°) ≈ 1.03 (≈ +3% torque for same current).
    • Mechanical power increases proportional to torque (at constant speed). If copper losses I^2 R unchanged, efficiency improves because mechanical output up.
    • For high-current cases where saturation previously caused extra losses, online saturation compensation can cut peak currents and losses more, producing larger gains (10–20%) in specially saturated regimes.
Quantify via experiments / simulation (recommended):
    1. Use the notebook to simulate a trip (speed profile → torque demand vs time) and compute energy used by baseline vs QMD-corrected torque per amp.
    2. Use bench dyno or vehicle test to measure actual Wh/km baseline vs with coil-sensing QMD engaged (most reliable).
    3. For robustness, test multiple operating regimes (start/stop, steady cruise, hill climb).

4 — Practical recommendations & next steps
    1. Bench demo: implement the MCU skeleton on an STM32 dev board with one phase of your motor on a bench dyno. Validate R(T) and L(θ) maps and verify demod SNR. Tune carrier_amp and f_carrier.
    2. Safety: coordinate with BMS and EMI requirements. Use small injection amplitude initially.
    3. Integration: connect lock-in estimates to the DE5 block:
        ◦ use L(θ) for angle interpolation and phase offset correction,
        ◦ use L(I) / dL/dI to detect saturation and reduce commanded current or apply non-linear k_t(I) correction,
        ◦ use R(T) to estimate coil temperature for derating.
    4. Field test: run standardized trips for baseline vs QMD as described earlier.
    5. Metrics: collect Wh/km, RMS torque error, coil temp, peak current, and controller stability metrics.

