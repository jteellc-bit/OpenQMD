### 🔧 Replacement: `DE5CurveGenerator` (canonical DE5 form)

```python
import numpy as np

class DE5CurveGenerator:
    """
    Converts DE5 parameter rows into torque/efficiency curves
    using the canonical DE5 rotation-curve formulation.

    Core model:
        v(r)^2 = (a0 + b0*r^2) / (1 + k_r*r^2 + λ*r^4)
    Derived torque ∝ r * dv/dr
    Efficiency ∝ v^2 / v_max^2

    All units are normalized (r ∈ [0,1]).
    """

    def __init__(self, n_points=200):
        self.n_points = n_points

    def de5_velocity(self, r, a0, b0, k_r, lam, phi, eta, xi):
        """
        Canonical DE5 equation (simplified scalar form).
        phi, eta, xi modulate curvature and damping terms.
        """
        denom = (1.0 + k_r * r**2 + lam * r**4)
        base = (a0 + b0 * r**2) / denom
        # hyperbolic modulation (Wildberger / RT-inspired form)
        mod = 1.0 + eta * np.tanh(phi * (r - xi))
        return np.sqrt(np.abs(base)) * mod

    def compute_curve(self, params):
        r = np.linspace(0, 1, self.n_points)
        v = self.de5_velocity(
            r,
            params['a0'],
            params['b0'],
            params['k_r'],
            params['lambda'],
            params['phi'],
            params['eta'],
            params['xi']
        )

        # --- derive torque and efficiency ---
        dr = r[1] - r[0]
        dv = np.gradient(v, dr)
        torque = r * dv * params.get('torque_scale', 1.0)
        efficiency = np.clip((v / np.max(v))**2, 0, 1.0)

        return {'x': r * 100, 'torque': torque * 10, 'eff': efficiency}

    def from_row(self, row_dict):
        # parse all parameters with defaults if missing
        def get(k, default):
            try:
                return float(row_dict.get(k, default))
            except:
                return default

        params = {
            'a0': get('a0', 1.0),
            'b0': get('b0', 0.5),
            'k_r': get('k_r', 0.3),
            'lambda': get('lambda', 0.05),
            'phi': get('phi', 1.0),
            'eta': get('eta', 0.2),
            'xi': get('xi', 0.5),
            'torque_scale': get('torque_scale', 1.0)
        }

        return self.compute_curve(params)

    def from_csv(self, path):
        import csv
        curves = []
        with open(path, 'r') as f:
            reader = csv.DictReader(f)
            for row in reader:
                try:
                    curves.append(self.from_row(row))
                except Exception:
                    continue
        return curves
```

