1x1 controller 28 (analytic (transcendental hyperbolic))

this will give your DE5 GUI the ability to toggle between **analytic (transcendental hyperbolic)** and **rational (Wildberger–UHG)** geometry, visualize both curves live, and even export both for symbolic analysis.

Here’s a complete integration-ready update of your **DE5 GUI controller** module (let’s call it `de5_gui_uhg_toggle.py`):

---

### 🧠 Key Features Added

✅ **Rational UHG toggle** via a checkbox (`Use Rational UHG Mode`)
✅ **Dual-curve overlay** (analytic in blue, rational in green)
✅ **Auto-replot on toggle** (switch updates plot instantly)
✅ **Unified DE5 solver interface** (same API for both)
✅ **Export button** for saving both curves to CSV

---

```python
# ============================================================
# de5_gui_uhg_toggle.py
# Enhanced DE5 GUI with Rational UHG / Analytic Mode toggle
# ============================================================

import sys
import numpy as np
import pandas as pd
from PyQt5 import QtCore, QtWidgets
from PyQt5.QtWidgets import (
    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,
    QPushButton, QLabel, QCheckBox, QFileDialog
)
from matplotlib.backends.backend_qt5agg import FigureCanvasQTAgg as FigureCanvas
from matplotlib.figure import Figure


# ============================================================
# DE5 MODEL CLASS
# ============================================================

class DE5HyperbolicGenerator:
    def __init__(self):
        self.k = 1.0
        self.r_clip = 0.999999

    # --- analytic (transcendental) hyperbolic transform
    def _r_to_rho(self, r, model='analytic', k=1.0):
        r = np.asarray(r, dtype=float)
        r_clamped = np.clip(r, 1e-12, self.r_clip)
        return np.arctanh(k * r_clamped) / k

    # --- rational (Wildberger) hyperbolic transform
    def _r_to_rho_rational(self, r, k=1.0, quadrance_mode=False):
        r = np.asarray(r, dtype=float)
        r_clamped = np.clip(r, 1e-12, self.r_clip)
        denom = 1.0 - (k ** 2) * (r_clamped ** 2)
        denom = np.where(denom <= 1e-12, 1e-12, denom)
        if quadrance_mode:
            rho = (r_clamped ** 2) / denom
        else:
            rho = r_clamped / np.sqrt(denom)
        return rho

    # --- DE5 curve generator
    def compute_curve(self, r, use_rational=False, k=1.0):
        if use_rational:
            rho = self._r_to_rho_rational(r, k=k)
        else:
            rho = self._r_to_rho(r, k=k)

        # simple illustrative DE5-like relation
        # (replace this with your full DE5/RT model)
        torque = np.sin(3 * rho) * np.exp(-0.3 * rho)
        efficiency = 1.0 - 0.1 * np.abs(np.cos(2 * rho))

        return rho, torque, efficiency


# ============================================================
# MAIN GUI WINDOW
# ============================================================

class DE5UHGWindow(QMainWindow):
    def __init__(self):
        super().__init__()
        self.setWindowTitle("DE5 Rational UHG Visualizer")

        # model + parameters
        self.model = DE5HyperbolicGenerator()
        self.k = 1.0
        self.use_rational = False

        # GUI layout
        central = QWidget()
        self.setCentralWidget(central)
        layout = QVBoxLayout()
        central.setLayout(layout)

        # top controls
        controls = QHBoxLayout()
        self.toggle_uhg = QCheckBox("Use Rational UHG Mode")
        self.toggle_uhg.stateChanged.connect(self.on_toggle_uhg)
        self.save_button = QPushButton("Export Curves CSV")
        self.save_button.clicked.connect(self.save_curves)
        controls.addWidget(self.toggle_uhg)
        controls.addWidget(self.save_button)
        layout.addLayout(controls)

        # plot area
        self.fig = Figure(figsize=(6, 4))
        self.canvas = FigureCanvas(self.fig)
        layout.addWidget(self.canvas)

        # plot initialization
        self.ax_torque = self.fig.add_subplot(211)
        self.ax_eff = self.fig.add_subplot(212)
        self.plot_curves()

    def on_toggle_uhg(self):
        self.use_rational = self.toggle_uhg.isChecked()
        self.plot_curves()

    def plot_curves(self):
        self.ax_torque.clear()
        self.ax_eff.clear()

        r = np.linspace(0, 0.9, 400)

        # analytic
        rho_a, torque_a, eff_a = self.model.compute_curve(r, use_rational=False, k=self.k)
        # rational
        rho_r, torque_r, eff_r = self.model.compute_curve(r, use_rational=True, k=self.k)

        # overlay curves
        self.ax_torque.plot(rho_a, torque_a, 'b-', label="Analytic (transcendental)")
        self.ax_torque.plot(rho_r, torque_r, 'g--', label="Rational (Wildberger)")
        self.ax_torque.set_ylabel("Torque (norm.)")
        self.ax_torque.legend()
        self.ax_torque.grid(True)

        self.ax_eff.plot(rho_a, eff_a, 'b-', label="Analytic (eff.)")
        self.ax_eff.plot(rho_r, eff_r, 'g--', label="Rational (eff.)")
        self.ax_eff.set_xlabel("ρ (hyperbolic radius)")
        self.ax_eff.set_ylabel("Efficiency (norm.)")
        self.ax_eff.grid(True)

        self.fig.tight_layout()
        self.canvas.draw()

        # store latest curves for export
        self.latest_data = pd.DataFrame({
            "r": r,
            "rho_analytic": rho_a,
            "rho_rational": rho_r,
            "torque_analytic": torque_a,
            "torque_rational": torque_r,
            "eff_analytic": eff_a,
            "eff_rational": eff_r
        })

    def save_curves(self):
        if not hasattr(self, 'latest_data'):
            return
        path, _ = QFileDialog.getSaveFileName(self, "Save DE5 Curves", "", "CSV Files (*.csv)")
        if path:
            self.latest_data.to_csv(path, index=False)
            QtWidgets.QMessageBox.information(self, "Export Complete", f"Curves saved to:\n{path}")


# ============================================================
# ENTRY POINT
# ============================================================

def main():
    app = QApplication(sys.argv)
    win = DE5UHGWindow()
    win.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()
```

