/* qmd_lowlevel_controller.c
   STM32-HAL skeleton for QMD low-level current control (double H-bridge)
   - 2 coil channels: COIL_A (stator), COIL_B (rotor)
   - Each coil driven by an H-bridge via PWM (TIM) and direction pins
   - Current measured via shunt ADC channels
   - Temp measured via thermistor ADC (or digital sensor)
   - Commands received on UART as CSV: "<chan>,<pol>,<I_target_A>\n"
     e.g. "A,1,12.5\n" or "B,-1,8.0\n" or a combined command "S,1,6.0;R,-1,6.0\n"
   - Safety: overcurrent, overtemp, watchdog, emergency stop
*/

#include "stm32f4xx_hal.h"
#include <string.h>
#include <stdio.h>
#include <stdlib.h>
#include <math.h>

/* -------------------------------------------------------------------------
   HAL handle stubs - replace with generated handles from CubeMX
   -------------------------------------------------------------------------*/
extern TIM_HandleTypeDef htim1; // PWM timer for COIL_A
extern TIM_HandleTypeDef htim2; // PWM timer for COIL_B
extern ADC_HandleTypeDef hadc1; // shunts and temp
extern UART_HandleTypeDef huart2; // host commands telemetry

/* -------------------------------------------------------------------------
   Configurable constants (tune to hardware)
   -------------------------------------------------------------------------*/
#define PWM_MAX_DUTY           10000   // timer ARR value for 100% duty
#define DEADTIME_COUNTS        50      // timer counts for deadtime insertion if hardware supports
#define CONTROL_LOOP_HZ        5000    // low-level loop frequency (Hz)
#define UART_RX_BUF_SZ         128

/* Current sense and conversion */
#define SHUNT_RESISTOR_OHM     0.0005f // e.g. 0.5 mΩ
#define ADC_REF_V              3.3f
#define ADC_RESOLUTION         4096.0f
#define AMPLIFIER_GAIN         100.0f  // if using op-amp
#define CURRENT_LSB_TO_AMP(adc_raw)  ( ((float)(adc_raw) * ADC_REF_V / ADC_RESOLUTION) / (SHUNT_RESISTOR_OHM * AMPLIFIER_GAIN) )

/* Safety limits */
#define I_CONTINUOUS_MAX_A     200.0f
#define I_PEAK_MAX_A           400.0f
#define I_OVERCURRENT_TRIP_A   420.0f
#define COIL_TEMP_CUTOFF       120.0f
#define COIL_TEMP_WARNING      100.0f

/* PI controller defaults */
#define KP_DEFAULT             0.45f
#define KI_DEFAULT             20.0f   // Ki in A/(A·s) * loop period units
#define INTEGRAL_MAX           10000.0f

/* Telemetry / status */
typedef enum { CH_OK=0, CH_OVERCURRENT, CH_OVERTEMP, CH_EMERGENCY } channel_fault_t;

/* -------------------------------------------------------------------------
   Data structures
   -------------------------------------------------------------------------*/
typedef struct {
    float I_target;     // A
    int8_t polarity;    // +1 or -1
    float I_measured;   // A
    float duty;         // 0..1
    float integrator;   // PI integrator state
    channel_fault_t fault;
} coil_ctrl_t;

/* global controllers */
static coil_ctrl_t coilA, coilB;

/* UART rx */
static uint8_t uart_rx_buf[UART_RX_BUF_SZ];
static volatile uint16_t uart_rx_head = 0;

/* Function prototypes */
void qmd_init(void);
void qmd_control_loop(void); // call at CONTROL_LOOP_HZ via timer interrupt or RTOS
void apply_pwm_A(float duty, int polarity);
void apply_pwm_B(float duty, int polarity);
float read_shunt_A(void);
float read_shunt_B(void);
float read_coil_temp_C(void);
void process_uart_buffer(void);
void emergency_stop(void);
void send_telemetry(void);

/* PI helper */
static float clampf(float v, float lo, float hi) {
    if (v < lo) return lo;
    if (v > hi) return hi;
    return v;
}

/* -------------------------------------------------------------------------
   Initialization: call from main() after HAL init + peripherals configured
   -------------------------------------------------------------------------*/
void qmd_init(void)
{
    /* initialize control structures */
    coilA.I_target = 0.0f; coilA.polarity = 1; coilA.I_measured = 0.0f; coilA.duty = 0.0f; coilA.integrator = 0.0f; coilA.fault = CH_OK;
    coilB.I_target = 0.0f; coilB.polarity = 1; coilB.I_measured = 0.0f; coilB.duty = 0.0f; coilB.integrator = 0.0f; coilB.fault = CH_OK;

    /* Start PWM timers - assumes TIM configured by CubeMX */
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);

    /* Start UART RX in interrupt or DMA circular mode */
    HAL_UART_Receive_IT(&huart2, uart_rx_buf, 1); // byte by byte interrupt
}

/* -------------------------------------------------------------------------
   UART RX callback (HAL) - store incoming bytes into circular buffer
   Implement this in your stm32f4xx_it.c / HAL UART RxCpltCallback
   -------------------------------------------------------------------------*/
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart == &huart2) {
        uint8_t b = uart_rx_buf[0];
        // push into head index (simple overflow safe)
        uart_rx_head = (uart_rx_head + 1) % UART_RX_BUF_SZ;
        uart_rx_buf[uart_rx_head] = b;
        // re-arm receive
        HAL_UART_Receive_IT(&huart2, uart_rx_buf, 1);
    }
}

/* -------------------------------------------------------------------------
   Process UART bytes into full lines (simple approach)
   Expected commands:
     Combined command: "S,<pol>,<I_A>;R,<pol>,<I_A>\n"  (stat or rotor)
     Single: "A,1,12.5\n"  or "B,-1,6.0\n"
   This parser is intentionally minimal — extend to JSON or protobuf for production.
   -------------------------------------------------------------------------*/
void process_uart_buffer(void)
{
    static char linebuf[128];
    static int linepos = 0;
    // read from head until newline
    static uint16_t last_read = 0;

    while (last_read != uart_rx_head) {
        last_read = (last_read + 1) % UART_RX_BUF_SZ;
        char ch = (char)uart_rx_buf[last_read];
        if (ch == '\r') continue;
        if (ch == '\n' || linepos >= (int)sizeof(linebuf)-1) {
            linebuf[linepos] = 0;
            if (linepos > 0) {
                // parse line
                // handle multiple semicolon-separated commands
                char *tok = strtok(linebuf, ";");
                while (tok) {
                    // trim
                    char *p = tok;
                    while (*p == ' ') p++;
                    // parse
                    char chan = 0;
                    int pol = 1;
                    float I_t = 0.0f;
                    if (sscanf(p, "%c,%d,%f", &chan, &pol, &I_t) >= 3) {
                        if (chan=='A' || chan=='S' || chan=='s') {
                            coilA.polarity = (pol>=0)?1:-1;
                            coilA.I_target = clampf(I_t, 0.0f, I_PEAK_MAX_A);
                        } else if (chan=='B' || chan=='R' || chan=='r') {
                            coilB.polarity = (pol>=0)?1:-1;
                            coilB.I_target = clampf(I_t, 0.0f, I_PEAK_MAX_A);
                        }
                    }
                    tok = strtok(NULL, ";");
                }
            }
            // reset
            linepos = 0;
            memset(linebuf,0,sizeof(linebuf));
        } else {
            linebuf[linepos++] = ch;
        }
    }
}

/* -------------------------------------------------------------------------
   Low-level periodic control loop
   Call this at CONTROL_LOOP_HZ using a timer interrupt or RTOS task.
   -------------------------------------------------------------------------*/
void qmd_control_loop(void)
{
    // 1) Read sensors (fast ADC conversion)
    float I_A = read_shunt_A(); // A
    float I_B = read_shunt_B(); // A
    float coil_temp = read_coil_temp_C();

    coilA.I_measured = I_A;
    coilB.I_measured = I_B;

    // 2) Safety checks
    if (I_A > I_OVERCURRENT_TRIP_A || I_B > I_OVERCURRENT_TRIP_A) {
        coilA.fault = CH_OVERCURRENT;
        coilB.fault = CH_OVERCURRENT;
        emergency_stop();
        return;
    }
    if (coil_temp > COIL_TEMP_CUTOFF) {
        coilA.fault = CH_OVERTEMP;
        coilB.fault = CH_OVERTEMP;
        emergency_stop();
        return;
    }
    if (coil_temp > COIL_TEMP_WARNING) {
        // optional: reduce targets or signal host
    }

    // 3) PI controllers per coil (basic anti-windup)
    float dt = 1.0f / (float)CONTROL_LOOP_HZ;

    // coil A PI
    float errA = coilA.I_target - coilA.I_measured;
    coilA.integrator += KI_DEFAULT * errA * dt;
    coilA.integrator = clampf(coilA.integrator, -INTEGRAL_MAX, INTEGRAL_MAX);
    float uA = KP_DEFAULT * errA + coilA.integrator;
    // convert uA (A error -> duty) using mapping: e.g., duty = uA / I_PEAK_MAX
    float dutyA = clampf(fabsf(uA) / I_PEAK_MAX_A, 0.0f, 1.0f);
    // apply polarity
    apply_pwm_A(dutyA, coilA.polarity);
    coilA.duty = dutyA;

    // coil B PI
    float errB = coilB.I_target - coilB.I_measured;
    coilB.integrator += KI_DEFAULT * errB * dt;
    coilB.integrator = clampf(coilB.integrator, -INTEGRAL_MAX, INTEGRAL_MAX);
    float uB = KP_DEFAULT * errB + coilB.integrator;
    float dutyB = clampf(fabsf(uB) / I_PEAK_MAX_A, 0.0f, 1.0f);
    apply_pwm_B(dutyB, coilB.polarity);
    coilB.duty = dutyB;

    // 4) periodic tasks (telemetry)
    static uint32_t telemetry_counter = 0;
    telemetry_counter++;
    if (telemetry_counter >= CONTROL_LOOP_HZ/10) { // 10 Hz telemetry
        telemetry_counter = 0;
        send_telemetry();
    }

    // 5) parse incoming UART bytes (non-blocking)
    process_uart_buffer();
}

/* -------------------------------------------------------------------------
   apply_pwm_A / apply_pwm_B - map duty & polarity into timer compare +
   direction GPIOs. Replace with your specific wiring.
   -------------------------------------------------------------------------*/
void apply_pwm_A(float duty, int polarity)
{
    // polarity -> direction GPIO
    if (polarity >= 0) {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_0, GPIO_PIN_SET); // DIR pin example
    } else {
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_0, GPIO_PIN_RESET);
    }
    uint32_t pulse = (uint32_t)(duty * (float)PWM_MAX_DUTY);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, pulse);
}

void apply_pwm_B(float duty, int polarity)
{
    if (polarity >= 0) {
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_SET);
    } else {
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_0, GPIO_PIN_RESET);
    }
    uint32_t pulse = (uint32_t)(duty * (float)PWM_MAX_DUTY);
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, pulse);
}

/* -------------------------------------------------------------------------
   Sensor read helpers -- implement ADC sequence and conversion
   -------------------------------------------------------------------------*/
float read_shunt_A(void)
{
    uint32_t adc_raw = 0;
    // start ADC, read channel for shunt A (blocking or DMA-managed)
    // HAL_ADC_Start / PollForConversion etc.
    HAL_ADC_Start(&hadc1);
    HAL_ADC_PollForConversion(&hadc1, 10);
    adc_raw = HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);
    return CURRENT_LSB_TO_AMP(adc_raw);
}

float read_shunt_B(void)
{
    uint32_t adc_raw = 0;
    // select other ADC channel if using single ADC multiplexer
    HAL_ADC_Start(&hadc1);
    HAL_ADC_PollForConversion(&hadc1, 10);
    adc_raw = HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);
    return CURRENT_LSB_TO_AMP(adc_raw);
}

float read_coil_temp_C(void)
{
    // simple ADC -> thermistor conversion placeholder
    uint32_t adc_raw = 0;
    HAL_ADC_Start(&hadc1);
    HAL_ADC_PollForConversion(&hadc1, 10);
    adc_raw = HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);
    float v = ((float)adc_raw) * ADC_REF_V / ADC_RESOLUTION;
    // convert v -> temperature using a calibration curve (NTC or IC sensor)
    // placeholder linear mapping
    float tempC = 25.0f + (v - 0.5f) * 100.0f;
    return tempC;
}

/* -------------------------------------------------------------------------
   emergency_stop - disables PWMs and sets faults
   -------------------------------------------------------------------------*/
void emergency_stop(void)
{
    // Set PWMs to zero
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
    __HAL_TIM_SET_COMPARE(&htim2, TIM_CHANNEL_1, 0);
    // Optionally disable gates / set enable pins off
    HAL_GPIO_WritePin(GPIOC, GPIO_PIN_1, GPIO_PIN_RESET); // e-stop pin example
    // Log and keep system in halted state
    // TODO: permit host to clear via UART command after manual inspection
}

/* -------------------------------------------------------------------------
   send_telemetry - simple CSV telemetry over UART
   Format: "T,<I_A>,<I_B>,<dutyA>,<dutyB>,<temp>\n"
   -------------------------------------------------------------------------*/
void send_telemetry(void)
{
    char msg[128];
    int n = snprintf(msg, sizeof(msg), "T,%.2f,%.2f,%.3f,%.3f,%.1f\n",
                     coilA.I_measured, coilB.I_measured, coilA.duty, coilB.duty, read_coil_temp_C());
    HAL_UART_Transmit(&huart2, (uint8_t*)msg, n, 10);
}

