/* main.c
 * Example skeleton - integrate with CubeMX-generated init
 * Replace HAL init and handle names to match your project.
 */

#include "stm32f4xx_hal.h" // change to your series
#include "de5_control.h"
#include "uart_cmd.h"
#include <stdio.h>

/* Hardware handles (CubeMX-generated) */
extern UART_HandleTypeDef huart2;
extern TIM_HandleTypeDef htim1;
extern ADC_HandleTypeDef hadc1;

/* A minimal uart_printf wrapper using HAL_UART_Transmit (blocking) */
void uart_printf(const char *fmt, ...) {
    char buf[256];
    va_list ap;
    va_start(ap, fmt);
    int n = vsnprintf(buf, sizeof(buf), fmt, ap);
    va_end(ap);
    if (n > 0) {
        HAL_UART_Transmit(&huart2, (uint8_t*)buf, (uint16_t)strnlen(buf, sizeof(buf)), HAL_MAX_DELAY);
    }
}

/* Hardware hook implementations */
float hw_read_current_A(void) {
    // TODO: read actual ADC channel mapping to current sensor and convert to Amps
    // Example stub:
    uint32_t raw = 0;
    HAL_ADC_Start(&hadc1);
    if (HAL_ADC_PollForConversion(&hadc1, 10) == HAL_OK) raw = HAL_ADC_GetValue(&hadc1);
    HAL_ADC_Stop(&hadc1);
    // Convert raw to voltage then to current using sensor gain
    float v = (raw / 4095.0f) * 3.3f;
    float current = (v - 1.65f) * 10.0f; // example: 10 A/V sensitivity
    return current;
}

float hw_read_temperature_C(void) {
    // TODO: read temp sensor ADC, convert to Celsius
    return 40.0f; // stub
}

void hw_set_pwm_duty(float duty_left, float duty_right) {
    // TODO: translate -1..1 to timer compare values and update TIMx->CCRn
    // Example assumes forward-only 0..1:
    if (duty_left < 0) duty_left = 0;
    if (duty_right < 0) duty_right = 0;
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, (uint32_t)(duty_left * 1000.0f));
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, (uint32_t)(duty_right * 1000.0f));
}

uint32_t hw_get_millis(void) {
    return HAL_GetTick();
}

void hw_safe_shutdown_outputs(void) {
    hw_set_pwm_duty(0.0f, 0.0f);
}

/* UART RX line buffer (simple blocking example) */
#define UART_LINE_MAX 128
static char uart_line[UART_LINE_MAX];
static uint16_t uart_line_pos = 0;

int main(void) {
    HAL_Init();
    SystemClock_Config(); // generated by CubeMX
    MX_GPIO_Init();
    MX_USART2_UART_Init();
    MX_TIM1_Init();
    MX_ADC1_Init();

    /* Start PWM timers */
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);

    de5_init();
    uart_cmd_init();

    uart_printf("DE5 MCU fallback booting...\r\n");

    /* If desired start in autonomous mode */
    //de5_start();

    uint32_t last_tick = hw_get_millis();
    while (1) {
        /* Poll UART (blocking read with small timeout) for command lines */
        uint8_t ch;
        if (HAL_UART_Receive(&huart2, &ch, 1, 10) == HAL_OK) {
            if ((ch == '\r') || (ch == '\n')) {
                if (uart_line_pos > 0) {
                    uart_line[uart_line_pos] = '\0';
                    uart_cmd_process_line(uart_line);
                    uart_line_pos = 0;
                }
            } else {
                if (uart_line_pos < UART_LINE_MAX-1) uart_line[uart_line_pos++] = (char)ch;
            }
        }

        /* periodic tick: run de5 tick at 100 ms */
        uint32_t now = hw_get_millis();
        if (now - last_tick >= 100) {
            de5_tick(now - last_tick);
            last_tick = now;
        }

        /* Optional: other tasks, ADC scans, safety checks */
        // ...
    }
}

Next steps & integration checklist
    1. Replace all TODO hardware stubs with CubeMX-generated handles and conversions (ADC scaling, temperature sensor calibration, PWM timer CCR mapping).
    2. Replace DE5_TABLE contents with your recent Top-30 CSV rows. You can write a small script to convert CSV rows into C DE5Row_t initializer lines.
    3. Decide whether to implement persistence of weights (flash write) — currently weights are RAM-only.
    4. Tune morph_cooldown_ms and morph_step_max to match your mechanical response and control latency.
    5. If you want the MCU to compute more precise current setpoints instead of naive duty, implement compute_itgt_for_row() and closed-loop PI on current measurement (add PI controller inside de5_tick).
    6. Test in --simulate mode with the PC GUI or by connecting serial and issuing STREAM ON, START, W T 0.5, etc.
    7. Add safety checks (over-current, torque limits, rotor-lock detection) before field testing.