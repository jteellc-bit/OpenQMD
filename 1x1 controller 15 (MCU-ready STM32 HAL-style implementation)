/* uart_cmd.c
 * Minimal line-based parser (blocking or interrupt-driven RX can push lines to this)
 *
 * Implementation notes:
 * - This file assumes you have a small buffering routine that collects full lines
 *   and calls uart_cmd_process_line on each complete line.
 * - For CubeMX interrupt-driven UART, accumulate bytes into a ring buffer and when
 *   CR/LF seen, call uart_cmd_process_line.
 */

#include "uart_cmd.h"
#include "de5_control.h"
#include <string.h>
#include <stdio.h>
#include <stdlib.h>

/* Provide a UART printf on your platform */
extern void uart_printf(const char *fmt, ...);

void uart_cmd_init(void) {
    // nothing for now
}

/* Process ASCII line (no newline) */
void uart_cmd_process_line(const char *line) {
    if (line == NULL) return;
    // Trim leading spaces
    while (*line == ' ') line++;
    if (strlen(line) == 0) return;

    // Simple uppercase matching
    if (strncmp(line, "R", 1) == 0) {
        // Row set: R<n>
        int n = atoi(line+1);
        if (n > 0) {
            de5_set_row((uint16_t)n);
            uart_printf("OK,ROW=%d\r\n", n);
        } else {
            uart_printf("ERR,BADROW\r\n");
        }
        return;
    }
    if (strncmp(line, "START", 5) == 0) {
        de5_start(); uart_printf("OK,START\r\n"); return;
    }
    if (strncmp(line, "STOP", 4) == 0) {
        de5_stop(); uart_printf("OK,STOP\r\n"); return;
    }
    if (strncmp(line, "STREAM ON", 9) == 0) { de5_stream_telemetry(true); uart_printf("OK,STREAM=ON\r\n"); return; }
    if (strncmp(line, "STREAM OFF", 10) == 0) { de5_stream_telemetry(false); uart_printf("OK,STREAM=OFF\r\n"); return; }

    // Weight set: W <T|E|P> <float>
    if (line[0] == 'W' && (line[1] == ' ' || line[1]=='\t')) {
        char var = 0; float val = 0.0f;
        if (sscanf(line+1, " %c %f", &var, &val) >= 1) {
            if (var == 'T') { de5_set_weights(val, de5_get_state().w_eff, de5_get_state().w_temp); uart_printf("OK,W_T=%.3f\r\n", val); return; }
            if (var == 'E') { de5_set_weights(de5_get_state().w_torque, val, de5_get_state().w_temp); uart_printf("OK,W_E=%.3f\r\n", val); return; }
            if (var == 'P') { de5_set_weights(de5_get_state().w_torque, de5_get_state().w_eff, val); uart_printf("OK,W_P=%.3f\r\n", val); return; }
            if (var == 'N') { int n = (int)val; de5_set_morph_params(de5_get_state().morph_cooldown_ms, (uint8_t)n); uart_printf("OK,MORPH_N=%d\r\n", n); return; }
        }
        uart_printf("ERR,BADW\r\n"); return;
    }

    if (strncmp(line, "GET", 3) == 0) {
        DE5State_t s = de5_get_state();
        uart_printf("STATE,ROW=%d,RUN=%d,WT=%.3f,WE=%.3f,WP=%.3f,COOL=%lu,STEP=%d\r\n",
                    s.active_row, s.running ? 1 : 0, s.w_torque, s.w_eff, s.w_temp,
                    (unsigned long)s.morph_cooldown_ms, s.morph_step_max);
        return;
    }

    // Unknown
    uart_printf("ERR,UNKNOWN_CMD\r\n");
}

void uart_cmd_poll(void) {
    /* If using non-interrupt UART, you can poll a receive buffer here and on line completion
     * call uart_cmd_process_line().
     * For interrupt driven, call uart_cmd_process_line from the IRQ handler / DMA completion.
     */
}

