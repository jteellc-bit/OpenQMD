/************************************************************
 * qmd_fp_test.c
 * ----------------------------------------------------------
 * Fixed-point Q16.16 DE5 model_E vs double-precision reference
 * Full sweep of tau, q, pwm to measure max absolute error.
 *
 * No external dependencies besides <math.h> for reference sqrt.
 *
 * Author: ChatGPT (QMD-4.0 Test Harness)
 ************************************************************/

#include <stdint.h>
#include <stdio.h>
#include <math.h>

/************************************************************
 * Q16.16 fixed-point helpers
 ************************************************************/

typedef int32_t q16;
typedef int64_t q64;

#define FIXONE ((q16)(1 << 16))

static inline q16 i2q(int32_t x){ return (q16)(x << 16); }
static inline int32_t q2i(q16 x){ return x >> 16; }

static inline q16 q_mul(q16 a, q16 b){
    return (q16)(((q64)a * b + (1LL<<15)) >> 16);
}

static inline q16 q_div(q16 a, q16 b){
    return (q16)(((q64)a << 16) / b);
}

static inline q16 q_abs(q16 a){ return (a < 0 ? -a : a); }

/************************************************************
 * Coefficients for model_E (fixed-point)
 ************************************************************/
static const double D_B0   = 84.3392;
static const double D_BTAU2= -4.43333;
static const double D_BQ   = 0.25;
static const double D_BPWM = 0.70;
static const double D_BX   = 0.012;

static const q16 B0    = (q16)(D_B0   * 65536.0);
static const q16 BTAU2 = (q16)(D_BTAU2* 65536.0);
static const q16 BQ    = (q16)(D_BQ   * 65536.0);
static const q16 BPWM  = (q16)(D_BPWM * 65536.0);
static const q16 BX    = (q16)(D_BX   * 65536.0);

/************************************************************
 * model_E in double precision (reference)
 ************************************************************/
double model_E_ref(double tau, double q, double pwm){
    double dt = tau - 1.0;
    double C = D_B0 + D_BQ*q + D_BPWM*pwm + D_BX*q*pwm;
    return D_BTAU2 * dt*dt + C;
}

/************************************************************
 * model_E in fixed-point Q16.16
 ************************************************************/
q16 model_E_fp(q16 tau_q16, int q, int pwm){
    q16 q_q16   = i2q(q);
    q16 pwm_q16 = i2q(pwm);

    q16 C = B0
          + q_mul(BQ, q_q16)
          + q_mul(BPWM, pwm_q16)
          + q_mul(BX, q_mul(q_q16, pwm_q16));

    q16 dt  = tau_q16 - FIXONE;
    q16 dt2 = q_mul(dt, dt);
    q16 term = q_mul(BTAU2, dt2);

    return term + C;
}

/************************************************************
 * Main test sweep
 ************************************************************/
int main(void){
    int q_vals[]   = {32,36,40,44,48};
    int pwm_vals[] = {8,12,16};

    double max_err = 0.0;

    printf("=====================================================\n");
    printf(" QMD-4.0 Fixed-Point Accuracy Test\n");
    printf(" model_E_fp (Q16.16) vs model_E_ref (double)\n");
    printf("=====================================================\n\n");

    printf("tau, q, pwm, E_fp, E_ref, abs_error\n");

    for(double tau=0.50; tau <= 1.50001; tau += 0.05){
        q16 tau_q16 = (q16)(tau * 65536.0);

        for(int qi=0; qi<5; ++qi){
            for(int pi=0; pi<3; ++pi){

                int q   = q_vals[qi];
                int pwm = pwm_vals[pi];

                /* fixed-point */
                q16 E_q16 = model_E_fp(tau_q16, q, pwm);
                double E_fp = E_q16 / 65536.0;

                /* reference */
                double E_ref = model_E_ref(tau, (double)q, (double)pwm);

                /* error */
                double err = fabs(E_fp - E_ref);
                if (err > max_err) max_err = err;

                printf("%4.2f, %2d, %2d, %8.4f, %8.4f, %10.6f\n",
                       tau, q, pwm, E_fp, E_ref, err);
            }
        }
    }

    printf("\n=====================================================\n");
    printf(" Maximum absolute error = %.8f %%\n", max_err);
    printf("=====================================================\n");

    return 0;
}

