/*
 * QMD_control.h
 *
 * DE5 / QMD MCU control interface (STM32 HAL)
 *
 * Public API for the realtime QMD controller:
 *  - PI current loops (safe)
 *  - PWM duty update (with clamping and deadtime safety)
 *  - UART command integration (high-level DE5 commands)
 *
 * Notes:
 *  - Units: currents in A, duty in [0..1.0], PWM period assumed 20 kHz default.
 *  - This header is intentionally self-contained: tune constants below per hardware.
 */

#ifndef QMD_CONTROL_H
#define QMD_CONTROL_H

#include "stm32f4xx_hal.h"
#include <stdbool.h>
#include <stdint.h>

/* === Hardware mapping: adapt if CubeMX uses different handles/names === */
/* These externs are defined in main.c after MX_... generated code */
extern TIM_HandleTypeDef htim1; /* PWM TIM1 -> Channel 1 (stator left) */
extern TIM_HandleTypeDef htim2; /* PWM TIM2 -> Channel 2 (stator right) */
extern TIM_HandleTypeDef htim3; /* PWM TIM3 -> Channel 3 (rotor) */
extern ADC_HandleTypeDef hadc1; /* current sense A */
extern ADC_HandleTypeDef hadc2; /* current sense B */
extern UART_HandleTypeDef huart2; /* command/status UART */

/* === Configuration constants (tune for your board / inverter) === */
#define QMD_PWM_TIMER_CLOCK_HZ   168000000UL /* APB clock used for PWM prescaler calc (example) */
#define QMD_PWM_FREQ_HZ          20000U      /* 20 kHz PWM switching */
#define QMD_PWM_MAX_DUTY         0.95f       /* safety clamp (95%) */
#define QMD_PWM_MIN_DUTY         0.0005f     /* avoid deadband  */
#define QMD_CONTROL_FREQ_HZ      1000U       /* control loop tick (1 kHz) */
#define QMD_ADC_SAMPLES          8U          /* moving-average window for ADC current */
#define QMD_I_MAX_A              400.0f      /* absolute maximum allowed current (hardware limit) */
#define QMD_I_SAFE_LIMIT_A       250.0f      /* conservative safe current limit */
#define QMD_I_DEFAULT_REF_A      20.0f       /* default current reference */

/* PI controller params (tune on bench) */
typedef struct {
    float kp;      /* proportional gain */
    float ki;      /* integral gain (per second) */
    float integ;   /* internal integrator state */
    float out_min; /* lower clamp */
    float out_max; /* upper clamp */
} qmd_pi_t;

/* channel ids */
typedef enum {
    QMD_CH_STAT_L = 0,   /* stator left H-bridge PWM */
    QMD_CH_STAT_R = 1,   /* stator right H-bridge PWM */
    QMD_CH_ROTOR  = 2,   /* rotor wireless H-bridge PWM */
    QMD_N_CHANNELS
} qmd_channel_t;

/* structure returned for telemetry */
typedef struct {
    float I_meas_A[QMD_N_CHANNELS];
    float I_ref_A[QMD_N_CHANNELS];
    float duty[QMD_N_CHANNELS];
    bool  fault;
} qmd_status_t;

/* Initialize the QMD control module (call after HAL inits) */
void QMD_Init(void);

/* Periodic tick to be called at QMD_CONTROL_FREQ_HZ (recommended from timer IRQ or main loop) */
void QMD_ControlTick(void);

/* Set per-channel current reference (A). Values are clamped to safe limits. */
void QMD_SetCurrentRef(qmd_channel_t ch, float I_ref_A);

/* Set entire vector of references */
void QMD_SetCurrentRefs(const float refs_A[QMD_N_CHANNELS]);

/* Get snapshot of current status (non-blocking) */
void QMD_GetStatus(qmd_status_t *st);

/* Hard stop / immediate shut-down (turns off all PWM outputs safely) */
void QMD_EmergencyStop(void);

/* Clear latched fault (after operator review) */
void QMD_ClearFault(void);

/* Set saturation model params (alpha, I_sat) - optional advanced tuning */
void QMD_SetSaturationParams(float alpha, float I_sat_A);

/* Stub hook: User-provided high-level DE5 solver call
 * Input: measurement snapshot (I_meas) plus optional state; returns desired I_refs
 * This is called inside QMD_ControlTick and must complete within control period.
 * Provide implementation in your project or leave default stub in QMD_control.c */
void DE5_ComputeControl(const float I_meas_A[QMD_N_CHANNELS], float I_ref_out_A[QMD_N_CHANNELS]);

#endif /* QMD_CONTROL_H */
