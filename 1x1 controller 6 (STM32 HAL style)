/*
 * main.c
 *
 * Minimal STM32CubeIDE main that wires up the QMD_control module.
 * - Initializes HAL, clocks, peripherals (generated MX_* functions are assumed)
 * - Implements a simple millisecond scheduler loop calling QMD_ControlTick at 1 kHz
 * - UART receives simple textual commands for quick bench control/control debugging
 *
 * Note: Add CubeMX generated MX_* functions into the project (GPIO, TIM, ADC, USART).
 *       This main expects the ioc mapping you imported earlier.
 */

#include "main.h"
#include "stm32f4xx_hal.h"
#include <string.h>
#include <stdio.h>
#include "QMD_control.h"

/* Peripheral handles: defined/instantiated by CubeMX generated code (MX_... functions) */
TIM_HandleTypeDef htim1;
TIM_HandleTypeDef htim2;
TIM_HandleTypeDef htim3;
ADC_HandleTypeDef hadc1;
ADC_HandleTypeDef hadc2;
UART_HandleTypeDef huart2;

/* Forward declarations of MX_ init functions (generated by CubeMX) */
void SystemClock_Config(void);
void MX_GPIO_Init(void);
void MX_TIM1_Init(void);
void MX_TIM2_Init(void);
void MX_TIM3_Init(void);
void MX_ADC1_Init(void);
void MX_ADC2_Init(void);
void MX_USART2_UART_Init(void);

/* simple UART buffer */
#define UART_RX_BUF 128
static uint8_t rx_buf[UART_RX_BUF];
static uint8_t rx_byte;

/* millisecond tick helpers */
volatile uint32_t ms_tick = 0;
void SysTick_Handler(void)
{
    HAL_IncTick();
    ms_tick++;
}

/* helper delay */
static void ms_delay(uint32_t ms)
{
    uint32_t t0 = ms_tick;
    while ((ms_tick - t0) < ms) { __NOP(); }
}

/* UART transmit helper */
static void uart_printf(const char *fmt, ...)
{
    char tx[256];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(tx, sizeof(tx), fmt, ap);
    va_end(ap);
    HAL_UART_Transmit(&huart2, (uint8_t*)tx, strlen(tx), 50);
}

/* simple command parser: SET_I ch val | STATUS | STOP | START | CLEAR_FAULT */
static void process_command(const char *cmd)
{
    if (strncmp(cmd, "SET_I ", 6) == 0) {
        int ch;
        float val;
        if (sscanf(cmd+6, "%d %f", &ch, &val) == 2 && ch >= 0 && ch < QMD_N_CHANNELS) {
            QMD_SetCurrentRef((qmd_channel_t)ch, val);
            uart_printf("OK: SET_I ch=%d -> %0.3f A\r\n", ch, val);
        } else {
            uart_printf("ERR: SET_I format: SET_I <ch> <amps>\r\n");
        }
    } else if (strncmp(cmd, "STATUS", 6) == 0) {
        qmd_status_t st;
        QMD_GetStatus(&st);
        uart_printf("STATUS: I_meas: %.2f, %.2f, %.2f | I_ref: %.2f, %.2f, %.2f | fault=%d\r\n",
            st.I_meas_A[0], st.I_meas_A[1], st.I_meas_A[2],
            st.I_ref_A[0], st.I_ref_A[1], st.I_ref_A[2],
            st.fault);
    } else if (strncmp(cmd, "STOP", 4) == 0) {
        QMD_EmergencyStop();
        uart_printf("OK: EMERGENCY STOP\r\n");
    } else if (strncmp(cmd, "CLEAR_FAULT", 11) == 0) {
        QMD_ClearFault();
        uart_printf("OK: FAULT CLEARED\r\n");
    } else if (strncmp(cmd, "SET_SAT ", 8) == 0) {
        float a, isat;
        if (sscanf(cmd+8, "%f %f", &a, &isat) == 2) {
            QMD_SetSaturationParams(a, isat);
            uart_printf("OK: sat alpha=%.3f I_sat=%.1f\r\n", a, isat);
        } else uart_printf("ERR: SET_SAT <alpha> <I_sat>\r\n");
    } else {
        uart_printf("ERR: unknown cmd\r\n");
    }
}

/* UART receive callback (called by HAL) */
void HAL_UART_RxCpltCallback(UART_HandleTypeDef *huart)
{
    if (huart->Instance == USART2) {
        static char cmdline[UART_RX_BUF];
        static uint16_t pos = 0;
        if (rx_byte == '\r' || rx_byte == '\n') {
            if (pos > 0) {
                cmdline[pos] = '\0';
                process_command(cmdline);
                pos = 0;
            }
        } else {
            if (pos < (UART_RX_BUF-1)) cmdline[pos++] = (char)rx_byte;
        }
        /* restart reception for next byte */
        HAL_UART_Receive_IT(&huart2, &rx_byte, 1);
    }
}

/* application entry */
int main(void)
{
    HAL_Init();
    SystemClock_Config();

    /* initialize peripherals (CubeMX generated functions must exist in project) */
    MX_GPIO_Init();
    MX_TIM1_Init();
    MX_TIM2_Init();
    MX_TIM3_Init();
    MX_ADC1_Init();
    MX_ADC2_Init();
    MX_USART2_UART_Init();

    /* Start UART rx interrupt for command input */
    HAL_UART_Receive_IT(&huart2, &rx_byte, 1);

    /* Initialize QMD module */
    QMD_Init();

    uart_printf("DE5/QMD controller boot OK. Ready.\r\n");

    /* control loop timing: call QMD_ControlTick at QMD_CONTROL_FREQ_HZ */
    const uint32_t tick_ms = 1000U / QMD_CONTROL_FREQ_HZ;
    uint32_t last = ms_tick;

    /* Main loop */
    while (1) {
        /* step scheduler */
        if ((ms_tick - last) >= tick_ms) {
            last += tick_ms;
            QMD_ControlTick();
        }
        /* optional: do background tasks, logging, telemetry e.g., send status every 500ms */
        static uint32_t last_status_ms = 0;
        if ((ms_tick - last_status_ms) > 500) {
            last_status_ms = ms_tick;
            qmd_status_t st;
            QMD_GetStatus(&st);
            char buf[128];
            snprintf(buf, sizeof(buf), "TSTAT I(%.2f,%.2f,%.2f) R(%.1f,%.1f,%.1f) F=%d\r\n",
                st.I_meas_A[0], st.I_meas_A[1], st.I_meas_A[2],
                st.I_ref_A[0], st.I_ref_A[1], st.I_ref_A[2],
                st.fault);
            HAL_UART_Transmit(&huart2, (uint8_t*)buf, strlen(buf), 50);
        }

        /* low-power wait */
