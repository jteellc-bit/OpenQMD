/*
 * QMD_control.c
 *
 * Implements a small, robust PI current control layer for the DE5/QMD system.
 * - Polls ADC channels (blocking brief poll; safe for 1kHz)
 * - Runs PI controllers for 3 channels
 * - Applies saturation model (optional) to cap demanded currents
 * - Updates PWM duty (via HAL TIM APIs)
 *
 * This is intentionally conservative and fully commented for bench tuning.
 */

#include "QMD_control.h"
#include <string.h>
#include <math.h>

/* extern handles from main.c (declared there) */
extern TIM_HandleTypeDef htim1;
extern TIM_HandleTypeDef htim2;
extern TIM_HandleTypeDef htim3;
extern ADC_HandleTypeDef hadc1;
extern ADC_HandleTypeDef hadc2;
extern UART_HandleTypeDef huart2;

/* Internal state */
static qmd_pi_t pi_ctrl[QMD_N_CHANNELS];
static float current_refs[QMD_N_CHANNELS];
static float meas_buffer[QMD_N_CHANNELS][QMD_ADC_SAMPLES];
static uint8_t meas_idx = 0;
static bool initialized = false;
static volatile bool latched_fault = false;

/* PWM channel to TIM mapping (assumes CubeMX configured as earlier) */
static void pwm_set_duty(qmd_channel_t ch, float duty);

/* ADC read helpers */
static float read_adc_current_A(ADC_HandleTypeDef *hadc); /* returns amps (approx) */

/* Saturation model (optional) */
static float sat_alpha = 1.0f;
static float sat_I_sat_A = 300.0f;

/* Default PI params (tune on hardware) */
static void default_pi_init(void)
{
    for (int i = 0; i < QMD_N_CHANNELS; ++i) {
        pi_ctrl[i].kp = 0.08f;   /* proportional gain */
        pi_ctrl[i].ki = 10.0f;   /* integral gain (per second) -> tuned with control tick */
        pi_ctrl[i].integ = 0.0f;
        pi_ctrl[i].out_min = -QMD_PWM_MAX_DUTY;
        pi_ctrl[i].out_max = QMD_PWM_MAX_DUTY;
    }
}

/* Simple anti-windup PI update (returns duty increment) */
static float pi_update(qmd_pi_t *pi, float err, float dt)
{
    /* P term */
    float up = pi->kp * err;
    /* I term */
    pi->integ += err * (pi->ki * dt);
    /* clamp integrator to avoid windup */
    if (pi->integ > pi->out_max) pi->integ = pi->out_max;
    if (pi->integ < pi->out_min) pi->integ = pi->out_min;
    float ui = pi->integ;
    float u = up + ui;
    /* clamp */
    if (u > pi->out_max) u = pi->out_max;
    if (u < pi->out_min) u = pi->out_min;
    return u;
}

/* convert duty fraction into CCR register value and write it safely */
static void pwm_set_ccr_safe(TIM_HandleTypeDef *htim, uint32_t channel, float duty)
{
    /* clamp */
    if (duty > QMD_PWM_MAX_DUTY) duty = QMD_PWM_MAX_DUTY;
    if (duty < 0.0f) duty = 0.0f;
    /* Convert to CCR assuming ARR already set */
    uint32_t arr = __HAL_TIM_GET_AUTORELOAD(htim);
    uint32_t ccr = (uint32_t)(duty * (float)arr + 0.5f);
    __HAL_TIM_SET_COMPARE(htim, channel, ccr);
}

/* Public API ------------------------------------------------------------- */

void QMD_Init(void)
{
    if (initialized) return;

    default_pi_init();

    /* start PWM outputs (channels must match ioc mapping) */
    HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1); /* stator left */
    HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_2); /* stator right */
    HAL_TIM_PWM_Start(&htim3, TIM_CHANNEL_3); /* rotor */

    /* start ADCs (single conversion polling mode used below) */
    HAL_ADC_Start(&hadc1);
    HAL_ADC_Start(&hadc2);

    /* initialize buffers & refs */
    memset(current_refs, 0, sizeof(current_refs));
    for (int i=0;i<QMD_N_CHANNELS;++i) {
        for (int j=0;j<QMD_ADC_SAMPLES;++j) meas_buffer[i][j] = 0.0f;
    }
    /* default current refs */
    current_refs[QMD_CH_STAT_L] = QMD_I_DEFAULT_REF_A;
    current_refs[QMD_CH_STAT_R] = QMD_I_DEFAULT_REF_A;
    current_refs[QMD_CH_ROTOR]  = 0.0f;

    latched_fault = false;
    initialized = true;
}

/* Safety immediate shut-down */
void QMD_EmergencyStop(void)
{
    /* set zero duty on all channels */
    pwm_set_ccr_safe(&htim1, TIM_CHANNEL_1, 0.0f);
    pwm_set_ccr_safe(&htim2, TIM_CHANNEL_2, 0.0f);
    pwm_set_ccr_safe(&htim3, TIM_CHANNEL_3, 0.0f);
    latched_fault = true;
}

/* Clear latched fault */
void QMD_ClearFault(void)
{
    latched_fault = false;
    for (int i=0;i<QMD_N_CHANNELS;++i) pi_ctrl[i].integ = 0.0f;
}

/* tick called at QMD_CONTROL_FREQ_HZ */
void QMD_ControlTick(void)
{
    if (!initialized) return;
    if (latched_fault) {
        /* ensure OFF */
        QMD_EmergencyStop();
        return;
    }

    const float dt = 1.0f / (float)QMD_CONTROL_FREQ_HZ;

    /* 1) Read currents (simple mapping: ADC1 -> stat_l, ADC2 -> stat_r, rotor mirrored) */
    float I_ch0 = read_adc_current_A(&hadc1);
    float I_ch1 = read_adc_current_A(&hadc2);
    float I_ch2 = (I_ch0 + I_ch1) * 0.5f; /* approximate rotor current if no separate sense */

    /* moving-average */
    meas_buffer[QMD_CH_STAT_L][meas_idx] = I_ch0;
    meas_buffer[QMD_CH_STAT_R][meas_idx] = I_ch1;
    meas_buffer[QMD_CH_ROTOR][meas_idx]  = I_ch2;
    meas_idx = (meas_idx + 1) % QMD_ADC_SAMPLES;

    float I_meas_avg[QMD_N_CHANNELS];
    for (int ch=0; ch<QMD_N_CHANNELS; ++ch) {
        float s = 0.0f;
        for (int k=0;k<QMD_ADC_SAMPLES;++k) s += meas_buffer[ch][k];
        I_meas_avg[ch] = s / (float)QMD_ADC_SAMPLES;
    }

    /* 2) High-level DE5 solver hook: compute desired I_refs (optional user override).
     *    By default DE5_ComputeControl simply passes through previously requested refs.
     *    Implement this function with your DE5 logic to produce dynamic I_refs.
     */
    float I_desired[QMD_N_CHANNELS];
    DE5_ComputeControl(I_meas_avg, I_desired);

    /* 3) apply saturation model & clamp */
    for (int ch=0; ch<QMD_N_CHANNELS; ++ch) {
        /* saturation scaling: simple soft clip: I_adj = I_des / (1 + alpha * (I_des/I_sat)^2) */
        float I_in = I_desired[ch];
        float ratio = I_in / sat_I_sat_A;
        float scale = 1.0f / (1.0f + sat_alpha * ratio * ratio);
        float I_adj = I_in * scale;
        /* clamp to absolute hardware limit */
        if (I_adj > QMD_I_MAX_A) I_adj = QMD_I_MAX_A;
        if (I_adj < -QMD_I_MAX_A) I_adj = -QMD_I_MAX_A;
        /* ensure request not above safe limit unless operator override (not implemented) */
        if (fabsf(I_adj) > QMD_I_SAFE_LIMIT_A) {
            /* set latched fault if operator hasn't authorized */
            /* For now we allow but log via fault flag if > MAX */
            latched_fault = false; /* keep false for now; user could switch a safety bit */
        }
        current_refs[ch] = I_adj;
    }

    /* 4) PI updates -> convert (I_ref - I_meas) to duty adjustments
     *    We use simple feedforward proportional mapping: duty = k_d * I_ref + PI_correction
     *    k_d should be calibrated: [A] -> duty fraction mapping. We'll use a nominal constant.
     */
    const float feedforward_k = 0.01f; /* duty per amp; tune on hardware */
    float duty_out[QMD_N_CHANNELS];
    for (int ch=0; ch<QMD_N_CHANNELS; ++ch) {
        float err = current_refs[ch] - I_meas_avg[ch];
        float u = pi_update(&pi_ctrl[ch], err, dt);
        /* feed-forward */
        float ff = feedforward_k * current_refs[ch];
        float duty = ff + u;
        /* clamp to [0..QMD_PWM_MAX_DUTY] (we assume only positive current control here) */
        if (duty < QMD_PWM_MIN_DUTY) duty = 0.0f;
        if (duty > QMD_PWM_MAX_DUTY) duty = QMD_PWM_MAX_DUTY;
        duty_out[ch] = duty;
    }

    /* 5) Safety checks: overcurrent, overtemperature (if sensor), etc.
     *    If any measured current exceeds absolute limit -> emergency stop.
     */
    for (int ch=0; ch<QMD_N_CHANNELS; ++ch) {
        if (fabsf(I_meas_avg[ch]) > QMD_I_MAX_A) {
            latched_fault = true;
            QMD_EmergencyStop();
            return;
        }
    }

    /* 6) Update PWM outputs */
    pwm_set_duty(QMD_CH_STAT_L, duty_out[QMD_CH_STAT_L]);
    pwm_set_duty(QMD_CH_STAT_R, duty_out[QMD_CH_STAT_R]);
    pwm_set_duty(QMD_CH_ROTOR,  duty_out[QMD_CH_ROTOR]);

    /* done */
}

/* Set single channel current ref (public) */
void QMD_SetCurrentRef(qmd_channel_t ch, float I_ref_A)
{
    if (ch >= QMD_N_CHANNELS) return;
    /* clamp */
    if (I_ref_A > QMD_I_MAX_A) I_ref_A = QMD_I_MAX_A;
    if (I_ref_A < -QMD_I_MAX_A) I_ref_A = -QMD_I_MAX_A;
    current_refs[ch] = I_ref_A;
}

/* vector set */
void QMD_SetCurrentRefs(const float refs_A[QMD_N_CHANNELS])
{
    for (int i=0;i<QMD_N_CHANNELS;++i) QMD_SetCurrentRef((qmd_channel_t)i, refs_A[i]);
}

void QMD_GetStatus(qmd_status_t *st)
{
    if (!st) return;
    /* quick snapshot (no lock needed for simple system) */
    for (int ch=0; ch<QMD_N_CHANNELS; ++ch) {
        /* compute averaged measurement to return */
        float s = 0.0f;
        for (int k=0;k<QMD_ADC_SAMPLES;++k) s += meas_buffer[ch][k];
        st->I_meas_A[ch] = s / (float)QMD_ADC_SAMPLES;
        st->I_ref_A[ch] = current_refs[ch];
        /* compute duty from TIM CCR/ARR */
        TIM_HandleTypeDef *ht = (ch==QMD_CH_STAT_L) ? &htim1 : (ch==QMD_CH_STAT_R) ? &htim2 : &htim3;
        uint32_t arr = __HAL_TIM_GET_AUTORELOAD(ht);
        uint32_t ccr = 0;
        if (ch==QMD_CH_STAT_L) ccr = __HAL_TIM_GET_COMPARE(&htim1, TIM_CHANNEL_1);
        if (ch==QMD_CH_STAT_R) ccr = __HAL_TIM_GET_COMPARE(&htim2, TIM_CHANNEL_2);
        if (ch==QMD_CH_ROTOR)  ccr = __HAL_TIM_GET_COMPARE(&htim3, TIM_CHANNEL_3);
        st->duty[ch] = (float)ccr / (float)arr;
    }
    st->fault = latched_fault;
}

/* set saturation params */
void QMD_SetSaturationParams(float alpha, float I_sat_A)
{
    if (alpha >= 0.0f) sat_alpha = alpha;
    if (I_sat_A > 0.0f) sat_I_sat_A = I_sat_A;
}

/* default user DE5 hook (weak) */
__weak void DE5_ComputeControl(const float I_meas_A[QMD_N_CHANNELS], float I_ref_out_A[QMD_N_CHANNELS])
{
    /* Default behavior: pass through static refs (current_refs array) */
    for (int i=0;i<QMD_N_CHANNELS;++i) {
        I_ref_out_A[i] = current_refs[i];
    }
}

/* ---------- Internal helpers ---------- */

static float read_adc_current_A(ADC_HandleTypeDef *hadc)
{
    /* Simple ADC -> amps conversion placeholder.
       Replace with board-specific shunt gain and amplifier scaling.
       Here: assume ADC 12-bit, Vref = 3.3V, shunt+opamp scale -> 0.01 V per A (10 mV/A). */
    if (HAL_OK != HAL_ADC_PollForConversion(hadc, 2)) {
        /* on poll timeout, return last value from buffer average */
        float s = 0.0f;
        for (int k=0;k<QMD_ADC_SAMPLES;++k) s += meas_buffer[0][k];
        return s / (float)QMD_ADC_SAMPLES;
    }
    uint32_t raw = HAL_ADC_GetValue(hadc); /* 12-bit */
    const float vref = 3.3f;
    float v = ((float)raw / 4095.0f) * vref;
    /* amplifier/shunt scaling: example 10 mV/A -> amps = V / 0.01 */
    const float volts_per_amp = 0.01f;
    float amps = v / volts_per_amp;
    return amps;
}

/* Map channel -> timer compare update */
static void pwm_set_duty(qmd_channel_t ch, float duty)
{
    if (ch == QMD_CH_STAT_L) pwm_set_ccr_safe(&htim1, TIM_CHANNEL_1, duty);
    else if (ch == QMD_CH_STAT_R) pwm_set_ccr_safe(&htim2, TIM_CHANNEL_2, duty);
    else if (ch == QMD_CH_ROTOR)  pwm_set_ccr_safe(&htim3, TIM_CHANNEL_3, duty);
}

