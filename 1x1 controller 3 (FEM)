## ⚙️ (B) Arduino / PlatformIO C++ Variant (QMD Control Skeleton)

This version abstracts the **QMD/DE5 output → PWM/H-Bridge control loop**.

```cpp
// QMD-Controlled H-Bridge Driver (Arduino/PlatformIO)
// Version: DE5_MotorController v0.1
// Description:
//   Basic framework to drive the 1×1 DE5 motor via QMD-computed coil commands.
//   Two main stator H-bridges (A, B) + optional third for fine control.

#include <Arduino.h>

// ===== Pin Assignments =====
#define HBRIDGE_A_IN1 3
#define HBRIDGE_A_IN2 4
#define HBRIDGE_B_IN1 5
#define HBRIDGE_B_IN2 6
#define PWM_FREQ 20000  // 20 kHz switching
#define UART_BAUD 115200

// ===== Runtime State =====
float i_ref_A = 0.0f;   // desired current stator A
float i_ref_B = 0.0f;   // desired current stator B
float i_meas_A = 0.0f;
float i_meas_B = 0.0f;

// ===== PI Controller Gains =====
float Kp = 0.1f;
float Ki = 0.05f;
float err_int_A = 0.0f, err_int_B = 0.0f;

// ===== Function Declarations =====
void setBridgePolarity(int in1, int in2, float u);
float PI_update(float ref, float meas, float &err_int);

// ===== Setup =====
void setup() {
  Serial.begin(UART_BAUD);
  pinMode(HBRIDGE_A_IN1, OUTPUT);
  pinMode(HBRIDGE_A_IN2, OUTPUT);
  pinMode(HBRIDGE_B_IN1, OUTPUT);
  pinMode(HBRIDGE_B_IN2, OUTPUT);
  analogWriteFrequency(HBRIDGE_A_IN1, PWM_FREQ);
  analogWriteFrequency(HBRIDGE_B_IN1, PWM_FREQ);
  Serial.println("DE5 QMD Motor Controller Ready");
}

// ===== Main Loop =====
void loop() {
  // Example: read DE5 QMD commands (CSV or serial string: "A:0.5,B:-0.3")
  if (Serial.available()) {
    String msg = Serial.readStringUntil('\n');
    if (msg.startsWith("A:")) {
      int idxB = msg.indexOf(",B:");
      i_ref_A = msg.substring(2, idxB).toFloat();
      i_ref_B = msg.substring(idxB + 3).toFloat();
    }
  }

  // Mock measured current (replace with ADC sampling)
  i_meas_A = i_ref_A * 0.9; 
  i_meas_B = i_ref_B * 0.9;

  // PI control output voltage (-1.0 to 1.0)
  float uA = PI_update(i_ref_A, i_meas_A, err_int_A);
  float uB = PI_update(i_ref_B, i_meas_B, err_int_B);

  setBridgePolarity(HBRIDGE_A_IN1, HBRIDGE_A_IN2, uA);
  setBridgePolarity(HBRIDGE_B_IN1, HBRIDGE_B_IN2, uB);

  delayMicroseconds(100);
}

// ===== Helper Functions =====
float PI_update(float ref, float meas, float &err_int) {
  float err = ref - meas;
  err_int += err * 0.001;
  float u = Kp * err + Ki * err_int;
  u = constrain(u, -1.0, 1.0);
  return u;
}

void setBridgePolarity(int in1, int in2, float u) {
  int pwm = abs(u) * 255;
  if (u >= 0) {
    analogWrite(in1, pwm);
    analogWrite(in2, 0);
  } else {
    analogWrite(in1, 0);
    analogWrite(in2, pwm);
  }
}
```

🧠 **Conceptual Flow:**

* The **DE5/QMD model** computes the constructive “push/pull” polarity pattern.
* The **C++ controller** receives those desired coil currents via UART.
* The H-bridge polarity flips emulate the dynamic pole-switching predicted by the DE5.
* This skeleton can be expanded for STM32CubeMX with three PWM channels and ADC current feedback.

