*** Add File: src/qmd/qmd5.c
+/*
+ * qmd5.c
+ * QMD v5.0 kernel implementation
+ *
+ * Fixed-point (Q12.20) polynomial:
+ *   eta(tau) = C0 + C2*(tau-1)^2 + C4*(tau-1)^4
+ *
+ * Analytic derivative:
+ *   eta'(tau) = 2*C2*(tau-1) + 4*C4*(tau-1)^3
+ *
+ * All coefficients are stored in Q12.20 (q20_t). Intermediate multiply uses int64_t.
+ */
+
+#include "qmd5.h"
+#include <stdint.h>
+
+/* Final tuned coefficients (Q12.20) - do not change without refit */
+static const q20_t C0_fp =  575821;   /* ~0.5491458893884329 */
+static const q20_t C2_fp =  596139;   /* ~0.5685220545151792 */
+static const q20_t C4_fp = -253691;   /* ~-0.24193823095151684 */
+
+/* compute (tau-1) ^ 2 in Q12.20 */
+static inline q20_t qmd5_dx2(q20_t dx_fp)
+{
+    return (q20_t)(((int64_t)dx_fp * (int64_t)dx_fp) >> 20);
+}
+
+/* public: eta(tau) */
+q20_t qmd5_eta(q20_t tau_fp)
+{
+    /* dx = tau - 1 */
+    q20_t dx = tau_fp - Q20_ONE;
+    q20_t dx2 = qmd5_dx2(dx);
+    q20_t dx4 = (q20_t)(((int64_t)dx2 * (int64_t)dx2) >> 20);
+
+    /* compute C0 + C2*dx2 + C4*dx4  (all q20) */
+    int64_t term_c2 = ((int64_t)C2_fp * (int64_t)dx2) >> 20;
+    int64_t term_c4 = ((int64_t)C4_fp * (int64_t)dx4) >> 20;
+    int64_t res = (int64_t)C0_fp + term_c2 + term_c4;
+
+    return (q20_t)res;
+}
+
+/* public: analytic derivative eta'(tau) */
+q20_t qmd5_eta_prime(q20_t tau_fp)
+{
+    q20_t dx = tau_fp - Q20_ONE;
+
+    /* dx^3 = (dx^2)*dx >> 20 */
+    q20_t dx2 = qmd5_dx2(dx);
+    q20_t dx3 = (q20_t)(((int64_t)dx2 * (int64_t)dx) >> 20);
+
+    /* term1 = 2*C2*dx, term3 = 4*C4*dx^3  (both q20 after >>20) */
+    int64_t term1 = (((int64_t)2 * (int64_t)C2_fp) * (int64_t)dx) >> 20;
+    int64_t term3 = (((int64_t)4 * (int64_t)C4_fp) * (int64_t)dx3) >> 20;
+
+    int64_t res = term1 + term3;
+    return (q20_t)res;
+}
+
