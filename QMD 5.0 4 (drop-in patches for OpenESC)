*** Add File: src/qmd/qmd5_integration.c
+/*
+ * qmd5_integration.c
+ *
+ * Optional float wrapper for legacy parts of firmware that still use float.
+ * This file is safe to compile with -fno-math-errno and on systems with float.
+ *
+ * Exposes a simple function:
+ *   float qmd5_eta_float(float tau)
+ *   float qmd5_eta_prime_float(float tau)
+ *
+ * Internally converts to Q12.20, uses fixed-point kernel, returns float.
+ */
+
+#include "qmd5.h"
+#include <stdint.h>
+
+float qmd5_eta_float(float tau)
+{
+    /* clamp tau to [0.5 .. 1.5] recommended */
+    if (tau < 0.5f) tau = 0.5f;
+    if (tau > 1.5f) tau = 1.5f;
+
+    q20_t tau_fp = FLOAT_TO_Q20(tau);
+    q20_t eta_fp = qmd5_eta(tau_fp);
+    return Q20_TO_FLOAT(eta_fp);
+}
+
+float qmd5_eta_prime_float(float tau)
+{
+    if (tau < 0.5f) tau = 0.5f;
+    if (tau > 1.5f) tau = 1.5f;
+
+    q20_t tau_fp = FLOAT_TO_Q20(tau);
+    q20_t eprime_fp = qmd5_eta_prime(tau_fp);
+    return Q20_TO_FLOAT(eprime_fp);
+}
+
