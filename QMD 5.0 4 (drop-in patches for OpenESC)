+/*
+ * qmd5.h
+ * QMD v5.0 kernel - public header
+ *
+ * Fixed-point Q12.20 implementation of eta(tau) and analytic derivative.
+ * No external dependencies; safe for embedded builds (uses int64_t internally).
+ */
+#ifndef QMD5_H_
+#define QMD5_H_
+
+#include <stdint.h>
+
+/* Q12.20 fixed point */
+typedef int32_t q20_t;
+#define Q20_ONE (1 << 20)
+#define FLOAT_TO_Q20(x) ((q20_t)((x) * (float)(1<<20)))
+#define Q20_TO_FLOAT(x) ((float)(x) / (float)(1<<20))
+
+/* Public API */
+q20_t qmd5_eta(q20_t tau_fp);
+q20_t qmd5_eta_prime(q20_t tau_fp);
+
+/* convenience - peak tau in Q12.20 (== 1.0) */
+#define QMD5_TAU_PEAK_FP (1 << 20)
+
+#endif /* QMD5_H_ */
+
*** End Patch
