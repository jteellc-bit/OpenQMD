// qmd_control.c
// Implements probing + adaptive switching
#include "qmd_control.h"
#include "main.h"      // for HAL_GetTick, etc.
#include <string.h>
#include <stdio.h>
#include <math.h>

// === Tunable constants (tune to your hardware/measurements) ===
#define QMD_PROBE_SAMPLING_MS      10    // sample every 10 ms during pulse
#define QMD_TORQUE_FILTER_ALPHA    0.2f  // small exponential filter for torque samples
#define QMD_MAX_SAFE_SWITCHES_PER_MIN 4  // safety cap (failsafe)
#define QMD_DEFAULT_MIN_SWITCH_MS  (60*1000) // 1 minute between switches by default
#define QMD_DEFAULT_SWITCH_MARGIN  0.05f // 5% torque improvement margin needed
#define QMD_DEFAULT_STABLE_COUNT   2     // require 2 consecutive confirmations

// === Internal state ===
static qmd_adaptive_t g_adaptive;
static volatile bool g_probe_running = false;
static qmd_probe_result_t g_probe_result;
static qmd_probe_cfg_t g_probe_cfg;
static uint32_t g_probe_start_ms = 0;
static uint32_t g_probe_stage_ms = 0;
static uint16_t g_probe_idx = 0;
static float g_torque_accum_before = 0.0f;
static uint32_t g_samples_before = 0;
static float g_torque_accum_pos = 0.0f;
static uint32_t g_samples_pos = 0;
static float g_torque_accum_neg = 0.0f;
static uint32_t g_samples_neg = 0;

// Placeholders: these functions are application-specific and should be implemented
extern void PWM_SetPhaseOffset(float deg);      // set DE5 phase (deg) to hardware via PWM timing
extern float ADC_ReadTorqueSensor(void);        // read torque from sensor or estimator
extern void Delay_ms(uint32_t ms);              // blocking delay (HAL_Delay)
extern uint32_t HAL_GetTick(void);

// Internal helpers
static float sample_filtered_torque(float prev, float raw) {
    return prev*(1.0f - QMD_TORQUE_FILTER_ALPHA) + raw*QMD_TORQUE_FILTER_ALPHA;
}

void QMD_Control_Init(void) {
    memset(&g_adaptive, 0, sizeof(g_adaptive));
    g_adaptive.enabled = true;
    g_adaptive.auto_mode = false;
    g_adaptive.current_mode = QMD_MODE_2HB;
    g_adaptive.min_switch_interval_ms = QMD_DEFAULT_MIN_SWITCH_MS;
    g_adaptive.switch_margin = QMD_DEFAULT_SWITCH_MARGIN;
    g_adaptive.stable_count_required = QMD_DEFAULT_STABLE_COUNT;
    g_adaptive.stable_count = 0;
    g_adaptive.last_switch_ms = 0;
    g_probe_running = false;
}

// Immediate safe mode switch (stop probe first)
void QMD_SetMode(qmd_mode_t mode) {
    // Safety: don't switch if probe running
    if (g_probe_running) return;
    // Safety: throttle switching by min interval
    uint32_t now = HAL_GetTick();
    if (now - g_adaptive.last_switch_ms < g_adaptive.min_switch_interval_ms) return;
    // perform hardware-level reconfig for timers/PWM as needed:
    // Example placeholder: reconfigure PWM mapping and deadtime, or flip mapping table
    // TODO: implement hardware-specific reinit functions:
    // HW_SetMode2HB() / HW_SetMode3HB()
    if (mode == QMD_MODE_2HB) {
        // HW_Mode_2HB();
    } else {
        // HW_Mode_3HB();
    }
    g_adaptive.current_mode = mode;
    g_adaptive.last_switch_ms = now;
    g_adaptive.stable_count = 0;
}

// Non-blocking start: will execute synchronous probe (blocking implementation here)
// Return false if busy
bool QMD_StartProbe(const qmd_probe_cfg_t *cfg) {
    if (g_probe_running) return false;
    if (cfg == NULL) return false;
    // copy config
    memcpy(&g_probe_cfg, cfg, sizeof(g_probe_cfg));
    // initialize accumulators
    g_probe_running = true;
    g_probe_idx = 0;
    g_probe_start_ms = HAL_GetTick();
    g_probe_stage_ms = g_probe_start_ms;
    g_torque_accum_before = 0.0f; g_samples_before = 0;
    g_torque_accum_pos = 0.0f; g_samples_pos = 0;
    g_torque_accum_neg = 0.0f; g_samples_neg = 0;
    memset(&g_probe_result, 0, sizeof(g_probe_result));
    // We'll implement the blocking probe flow here for clarity.
    // If you prefer non-blocking, convert to coroutine / timer-based state machine.
    // --- collect baseline (before) ---
    const uint32_t baseline_ms = 100; // baseline sample window
    uint32_t t0 = HAL_GetTick();
    float torque_filt = 0.0f;
    while (HAL_GetTick() - t0 < baseline_ms) {
        float raw = ADC_ReadTorqueSensor();
        torque_filt = sample_filtered_torque(torque_filt, raw);
        g_torque_accum_before += torque_filt;
        g_samples_before++;
        Delay_ms(QMD_PROBE_SAMPLING_MS);
    }
    // --- apply pulses: alternating +delta, -delta around current phase ---
    float base_phase_deg = 0.0f; // read current DE5 phase setpoint; placeholder:
    // TODO: read from active setpoint storage if you store per-mode phase offsets
    for (uint16_t i=0; i < g_probe_cfg.n_pulses && g_probe_running; ++i) {
        // positive probe
        PWM_SetPhaseOffset(base_phase_deg + g_probe_cfg.delta_phi_deg);
        uint32_t stamp = HAL_GetTick();
        while (HAL_GetTick() - stamp < g_probe_cfg.pulse_ms) {
            float raw = ADC_ReadTorqueSensor();
            torque_filt = sample_filtered_torque(torque_filt, raw);
            g_torque_accum_pos += torque_filt;
            g_samples_pos++;
            Delay_ms(QMD_PROBE_SAMPLING_MS);
        }
        // small inter-pulse wait
        Delay_ms(g_probe_cfg.inter_pulse_ms);
        // negative probe
        PWM_SetPhaseOffset(base_phase_deg - g_probe_cfg.delta_phi_deg);
        stamp = HAL_GetTick();
        while (HAL_GetTick() - stamp < g_probe_cfg.pulse_ms) {
            float raw = ADC_ReadTorqueSensor();
            torque_filt = sample_filtered_torque(torque_filt, raw);
            g_torque_accum_neg += torque_filt;
            g_samples_neg++;
            Delay_ms(QMD_PROBE_SAMPLING_MS);
        }
        // restore base phase briefly
        PWM_SetPhaseOffset(base_phase_deg);
        Delay_ms(g_probe_cfg.inter_pulse_ms);
    }
    // compute means
    float mean_before = (g_samples_before>0) ? (g_torque_accum_before / (float)g_samples_before) : 0.0f;
    float mean_pos = (g_samples_pos>0) ? (g_torque_accum_pos / (float)g_samples_pos) : 0.0f;
    float mean_neg = (g_samples_neg>0) ? (g_torque_accum_neg / (float)g_samples_neg) : 0.0f;
    // score: prefer side (pos/neg) that increases torque relative to baseline
    float delta_pos = (mean_pos - mean_before);
    float delta_neg = (mean_neg - mean_before);
    float score = 0.0f;
    // positive score means positive probe increases torque
    if (fabsf(delta_pos) > fabsf(delta_neg)) {
        score = delta_pos / (fabsf(mean_before) + 1e-6f);
    } else {
        score = - delta_neg / (fabsf(mean_before) + 1e-6f);
    }
    // Fill result
    g_probe_result.torque_mean_before = mean_before;
    g_probe_result.torque_mean_after_pos = mean_pos;
    g_probe_result.torque_mean_after_neg = mean_neg;
    g_probe_result.score = score;
    g_probe_result.samples_collected = g_samples_before + g_samples_pos + g_samples_neg;
    g_probe_running = false;
    return true;
}

// Non-blocking query (true if result ready)
bool QMD_QueryProbeResult(qmd_probe_result_t *out) {
    if (g_probe_running) return false;
    if (out == NULL) return false;
    memcpy(out, &g_probe_result, sizeof(g_probe_result));
    return true;
}

// Adaptive control: call periodically (100-500 ms). It will trigger probes and decide mode.
void QMD_EnableAdaptive(bool on) {
    g_adaptive.auto_mode = on;
}
void QMD_AdaptiveStep(void) {
    // No-op if disabled
    if (!g_adaptive.auto_mode) return;
    // Periodically run quick probe and evaluate modes
    // For simplicity: run probe in current mode and compute score; if score negative big then try other mode
    qmd_probe_cfg_t probe_cfg = {
        .delta_phi_deg = 5.0f,
        .pulse_ms = 40,
        .n_pulses = 3,
        .inter_pulse_ms = 10
    };
    if (!QMD_StartProbe(&probe_cfg)) return; // busy
    qmd_probe_result_t res;
    // blocking wait until result ready
    while (!QMD_QueryProbeResult(&res)) { Delay_ms(10); }
    // Use margin-based decision: if score > switch_margin and stable_count reaches required then switch
    float score = res.score;
    // Normalize score to percent
    if (score > g_adaptive.switch_margin) {
        // candidate improvement detected
        g_adaptive.stable_count++;
        if (g_adaptive.stable_count >= g_adaptive.stable_count_required) {
            // set preferred mode to current (no-op) or try alternate mode probing?
            // we prefer to check alternate mode: quick anti-probe
            qmd_mode_t alt = (g_adaptive.current_mode == QMD_MODE_2HB) ? QMD_MODE_3HB : QMD_MODE_2HB;
            // try quick probe in alt mode (simulate: switch, measure, revert if worse)
            uint32_t now = HAL_GetTick();
            if (now - g_adaptive.last_switch_ms < g_adaptive.min_switch_interval_ms) {
                // too soon to switch
                return;
            }
            // perform safe test: switch to alt, run a short probe, compare
            QMD_SetMode(alt); // switches hardware
            Delay_ms(200); // let settle
            QMD_StartProbe(&probe_cfg);
            qmd_probe_result_t res_alt;
            while (!QMD_QueryProbeResult(&res_alt)) { Delay_ms(10); }
            // choose better mean torque
            float baseline_current_mode = res.torque_mean_before;
            float alt_mean = fmaxf(res_alt.torque_mean_after_pos, res_alt.torque_mean_after_neg);
            float curr_mean = fmaxf(res.torque_mean_after_pos, res.torque_mean_after_neg);
            // if alt is better by margin, keep alt
            if ((alt_mean - curr_mean) / (fabsf(curr_mean)+1e-6f) > g_adaptive.switch_margin) {
                // keep alt (already set)
                g_adaptive.last_switch_ms = HAL_GetTick();
                g_adaptive.stable_count = 0;
            } else {
                // revert
                qmd_mode_t revert = (alt == QMD_MODE_2HB) ? QMD_MODE_3HB : QMD_MODE_2HB;
                QMD_SetMode(revert);
                g_adaptive.stable_count = 0;
            }
        }
    } else {
        // score not significant => reset counter
        g_adaptive.stable_count = 0;
    }
}

