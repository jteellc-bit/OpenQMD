// Simple text commands parser (extensible)
void QMD_UART_HandleCommand(const char *cmd_line) {
    if (strncmp(cmd_line, "PROBE", 5) == 0) {
        // PROBE <delta_deg> <pulse_ms> <n_pulses>
        float d; int p; int n;
        if (sscanf(cmd_line+5, "%f %d %d", &d, &p, &n) >= 3) {
            qmd_probe_cfg_t cfg = { .delta_phi_deg = d, .pulse_ms = p, .n_pulses = (uint16_t)n, .inter_pulse_ms = 10 };
            if (QMD_StartProbe(&cfg)) {
                // blocking in this implementation; report when done
                qmd_probe_result_t r;
                while (!QMD_QueryProbeResult(&r)) Delay_ms(10);
                printf("PROBE_DONE score=%.3f before=%.3f pos=%.3f neg=%.3f samples=%u\r\n",
                       r.score, r.torque_mean_before, r.torque_mean_after_pos, r.torque_mean_after_neg, r.samples_collected);
            } else {
                printf("PROBE_BUSY\r\n");
            }
        } else {
            printf("PROBE_SYNTAX\r\n");
        }
    } else if (strncmp(cmd_line, "SETMODE",7) == 0) {
        char arg[8]; if (sscanf(cmd_line+7, "%s", arg) == 1) {
            if (strcmp(arg,"2HB")==0) QMD_SetMode(QMD_MODE_2HB);
            else if (strcmp(arg,"3HB")==0) QMD_SetMode(QMD_MODE_3HB);
            else printf("SETMODE_UNKNOWN\r\n");
            printf("MODE=%d\r\n", (int)g_adaptive.current_mode);
        }
    } else if (strncmp(cmd_line,"ADAPT",5) == 0) {
        char arg[8]; if (sscanf(cmd_line+5,"%s",arg)==1) {
            if (strcmp(arg,"ON")==0) { QMD_EnableAdaptive(true); printf("ADAPT=ON\r\n"); }
            else { QMD_EnableAdaptive(false); printf("ADAPT=OFF\r\n"); }
        }
    } else if (strncmp(cmd_line,"REPORT",6) == 0) {
        printf("MODE=%d LAST_SWITCH=%lu STABLE_CNT=%u\r\n", (int)g_adaptive.current_mode, g_adaptive.last_switch_ms, g_adaptive.stable_count);
    } else {
        printf("UNKNOWN_CMD\r\n");
    }
}

Integration in main.c (sketch)
Below is a minimal main loop showing where to call the adaptive step and telemetry functions. Replace placeholders with your actual ADC/PWM implementations.
// main.c (relevant excerpts)
#include "qmd_control.h"
#include "usart.h" // printf over UART
#include "adc.h"
#include "pwm.h"

int main(void) {
    HAL_Init();
    SystemClock_Config();
    MX_GPIO_Init();
    MX_USART2_UART_Init();
    MX_ADC1_Init();
    MX_TIM_PWM_Init();

    QMD_Control_Init();
    QMD_SetMode(QMD_MODE_2HB); // default

    uint32_t last_adapt_ms = HAL_GetTick();
    uint32_t last_tel_ms = HAL_GetTick();

    // example: enable adaptive
    QMD_EnableAdaptive(true);

    while (1) {
        // --- handle incoming UART commands (non-blocking) ---
        char rxline[128];
        if (uart_readline_nonblocking(rxline, sizeof(rxline))) {
            QMD_UART_HandleCommand(rxline);
        }

        // --- adaptive step every 5s (example) ---
        uint32_t now = HAL_GetTick();
        if (now - last_adapt_ms > 5000) {
            QMD_AdaptiveStep();
            last_adapt_ms = now;
        }

        // --- stream telemetry every 200 ms ---
        if (now - last_tel_ms > 200) {
            QMD_StreamTelemetryLine();
            last_tel_ms = now;
        }

        // ... other application tasks ...
        HAL_Delay(10);
    }
}

Example UART workflow and commands
    • PROBE 5 40 3 — run probe with ±5° pulses, 40 ms pulse, 3 repetitions (blocking in this impl).
    • SETMODE 3HB — force hardware to 3HB mode immediately (if safe).
    • ADAPT ON / ADAPT OFF — enable/disable automatic adaptive switching.
    • REPORT — print adaptive status line.
When a PROBE finishes, firmware prints:
PROBE_DONE score=0.087 before=10.12 pos=10.95 neg=9.65 samples=90
Interpretation: score positive → pos offset improved torque vs baseline.

Telemetry CSV format suggestion
Stream one line per telemetry interval (e.g., 200 ms) as CSV:
timestamp_ms,mode,torque_Nm,coil_temp_C,efficiency, I_req_A, probe_score
Example:
1625234123,2,10.123,78.5,0.962,120.0,0.087
During probes, you can also stream raw probe sample lines for post-processing:
PROBE_SAMPLE,stamp_ms,phase_deg,torque

Safety and tuning notes (must-read)
    • Blocking probe: The implementation above blocks while probing for simplicity. For best realtime behavior convert QMD_StartProbe into a state-machine (non-blocking) driven by a hardware timer or RTOS task.
    • Clamp limits: Ensure your PWM_SetPhaseOffset() enforces phase limits and that the motor driver is inhibited while switching major topology to avoid uncontrolled voltages. Add dead-time and desaturation checks.
    • Torque sensor: If you lack a torque sensor, use a reliable torque proxy (filtered electrical power minus losses, or current * k_t). Validate probe sensitivity before using adaptive switching.
    • Switching hysteresis: We added min_switch_interval_ms and a stable_count_required. Increase these on real hardware to avoid excessive switches (e.g., min 60 s, stable_count 3).
    • Probe amplitude: Use small Δφ (2–10°) in early tests. Too-large perturbations can induce transient torque spikes / mechanical stress.
    • Thermal & current safety: Before switching topology, verify coil_temp_C < T_safe and I_req_A < I_bus_limit. Add additional checks in QMD_SetMode.
    • Fault recovery: If a switch causes faults (overcurrent, driver fault), revert to safe default (disable PWM, notify host).

