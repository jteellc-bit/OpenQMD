qmd_control.h
// qmd_control.h
// MCU-side DE5 / QMD control utilities: probe + adaptive mode switching
// STM32 HAL style
#ifndef QMD_CONTROL_H
#define QMD_CONTROL_H

#include <stdint.h>
#include <stdbool.h>

typedef enum {
    QMD_MODE_2HB = 0,
    QMD_MODE_3HB = 1,
} qmd_mode_t;

typedef struct {
    // probe configuration
    float delta_phi_deg;     // ± degrees probe amplitude (deg)
    uint32_t pulse_ms;       // single pulse duration (ms)
    uint16_t n_pulses;       // number of ± pulses
    uint32_t inter_pulse_ms; // wait between pulses
} qmd_probe_cfg_t;

typedef struct {
    float torque_mean_before;
    float torque_mean_after_pos;
    float torque_mean_after_neg;
    float score;             // positive if constructive effect
    uint32_t samples_collected;
} qmd_probe_result_t;

typedef struct {
    bool enabled;
    bool auto_mode;          // adaptive switching enabled
    qmd_mode_t current_mode;
    qmd_mode_t preferred_mode; // suggested by adaptive logic
    uint32_t last_switch_ms;  // timestamp of last switch
    uint32_t min_switch_interval_ms; // safety interval
    float switch_margin;      // required score margin to switch
    uint8_t stable_count_required; // consecutive confirmations
    uint8_t stable_count;     // running counter
} qmd_adaptive_t;

void QMD_Control_Init(void);
void QMD_SetMode(qmd_mode_t mode); // immediate safe switch
qmd_mode_t QMD_GetMode(void);

bool QMD_StartProbe(const qmd_probe_cfg_t *cfg);
bool QMD_QueryProbeResult(qmd_probe_result_t *out); // non-blocking; returns true if result ready

void QMD_EnableAdaptive(bool on);
void QMD_AdaptiveStep(void); // call periodically (e.g., 100–500 ms)
void QMD_ProcessTelemetry(float torque, float coil_temp_C, float efficiency, float i_req);

/// UART / host support (simple helpers)
void QMD_UART_HandleCommand(const char *cmd_line); // parse textual commands
void QMD_StreamTelemetryLine(void); // called periodically to push CSV line (if enabled)

#endif // QMD_CONTROL_H

