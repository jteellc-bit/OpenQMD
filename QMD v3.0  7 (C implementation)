/**********************************************************************
 *  DE5 Kernel v3.0 -- Standalone C Implementation (Option A)
 *  Functions:
 *      float eta_eval(float tau);
 *      float tau_from_eta(float eta);
 *
 *  Polynomial reciprocal enabled
 *  No external dependencies
 *  No <math.h> required
 *********************************************************************/

#include <stdint.h>
#include <float.h>

/* ================================================================
   Utility: fast polynomial reciprocal approximation
   Computes 1/x with ~1.5 ulp accuracy for positive x
   ---------------------------------------------------------------- */
static float recip_poly(float x)
{
    /* 3rd-order reciprocal polynomial (minimax on [0.2, 5.0]) */
    const float p0 = 1.996138f;
    const float p1 = -1.195758f;
    const float p2 = 0.217180f;
    const float p3 = -0.017560f;

    float r = p0 + x*(p1 + x*(p2 + x*p3));
    return r;
}

/* ================================================================
   Forward Model: η(τ)
   η(τ) = 1 - a*(τ-1)^2 - b*(τ-1)^4
   ---------------------------------------------------------------- */
float eta_eval(float tau)
{
    const float a = 0.280000f;
    const float b = 0.080000f;

    float x  = tau - 1.0f;
    float x2 = x * x;
    float x4 = x2 * x2;

    return 1.0f - a*x2 - b*x4;
}

/* ================================================================
   Inverse Model: τ(η)
   Solve for τ given efficiency η.
   Using polynomial reciprocal in quadratic.
   ---------------------------------------------------------------- */
float tau_from_eta(float eta)
{
    const float a = 0.280000f;
    const float b = 0.080000f;

    /* Solve: b*y^2 + a*y + (eta - 1) = 0 , where y = x^2 >= 0 */

    float C = eta - 1.0f;
    float bb = b + b;    /* 2b */
    float disc = a*a - 4.0f*b*C;

    /* Discriminant clamp */
    if (disc < 0.0f) disc = 0.0f;

    /* sqrt via reciprocal polynomial */
    /* sqrt(z) ≈ z * recip_poly(sqrt guess) ... but here simpler:
       crude Newton correction with reciprocal. */
    float z = disc;
    float g = (z > 0.0f ? z : 1e-6f);
    float r = recip_poly(g);   /* approximate 1/g */
    float s = z * r;           /* approx z/g ≈ sqrt */

    /* One Newton step: s <- 0.5*(s + z/s) */
    float rs = recip_poly(s);
    s = 0.5f*(s + z*rs);

    float sqrt_disc = s;

    /* Quadratic roots: y = (-a + sqrt_disc) / (2b) */
    float denom = bb;
    float rcp   = recip_poly(denom);
    float y     = (-a + sqrt_disc) * rcp;

    if (y < 0.0f) y = 0.0f;

    /* x = ± sqrt(y); symmetric so choose physical + branch */
    /* sqrt via one Newton + reciprocal */
    float gy = (y > 0.0f ? y : 1e-6f);
    float ry = recip_poly(gy);
    float sy = y * ry;
    float rsy = recip_poly(sy);
    sy = 0.5f*(sy + y*rsy);

    float x = sy;

    return 1.0f + x;
}

