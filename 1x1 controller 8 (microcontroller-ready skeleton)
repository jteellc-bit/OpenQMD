### 📁 File `QMD_Control.c` (bridge layer)

```c
#include "QMD_Control.h"
#include "DE5_Control.h"

extern void SetPWM_FromVoltageCommand(float v_norm);

/* Basic placeholder for QMD dynamics */
void QMD_Update(float rotor_angle, float measured_current)
{
    DE5_Command cmd;
    DE5_ComputeControl(rotor_angle, measured_current, &cmd);
    SetPWM_FromVoltageCommand(cmd.V_command);
}
